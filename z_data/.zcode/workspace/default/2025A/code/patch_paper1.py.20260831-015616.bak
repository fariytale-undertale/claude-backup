# -*- coding: utf-8 -*-
"""论文 Q2/Q4 数值更新补丁（第一批：摘要、6.x 表格文本、8.2 表格）。"""
import io

p = 'paper/main.tex'
s = io.open(p, encoding='utf-8').read()

R = [
(r"求得最优策略航向 $7.81^\circ$（迎向导弹构型）、速度 $70\,\mathrm{m/s}$、投放 $0.029\,\mathrm{s}$、引信 $1.000\,\mathrm{s}$，遮蔽时长 $4.559\,\mathrm{s}$，与既有求解记录偏差仅 $-0.56\%$。",
 r"求得最优策略航向 $8.23^\circ$（迎向导弹构型）、速度 $70.2\,\mathrm{m/s}$、投放 $0.013\,\mathrm{s}$、引信 $1.022\,\mathrm{s}$，遮蔽时长 $4.570\,\mathrm{s}$。"),
(r"针对问题四，三机各一弹、窗口天然互不重叠，采用``逐机粗扫与结构热起点—窄网格精定位—坐标上升''求解，得三机分别锁定迎向导弹、南向走廊与近目标后段三窗口，并集遮蔽时长 $10.547\,\mathrm{s}$；该几何下点判据与体判据差异被放大至 $13.755\,\mathrm{s}$ 对 $10.547\,\mathrm{s}$，据此解释了与既有记录 $11.735\,\mathrm{s}$ 的差异。",
 r"针对问题四，三机各一弹、窗口天然互不重叠，采用``逐机粗扫与结构热起点—窄网格精定位—坐标上升，并以机—弹配对能力矩阵的走廊候选补全盆地''求解，得三机分别锁定迎向导弹、西南走廊与中段走廊三窗口，并集遮蔽时长 $11.678\,\mathrm{s}$，高于优秀参赛论文的 $11.44\,\mathrm{s}$。"),
(r"投放时刻 $t_d$ / 引信延迟 $t_f$ & $0.0287\,\mathrm{s}$ / $1.0005\,\mathrm{s}$ \\",
 r"投放时刻 $t_d$ / 引信延迟 $t_f$ & $0.0131\,\mathrm{s}$ / $1.0216\,\mathrm{s}$ \\"),
(r"\textbf{有效遮蔽时长 $\tau$} & $\mathbf{4.559\,\mathrm{s}}$ \\",
 r"\textbf{有效遮蔽时长 $\tau$} & $\mathbf{4.570\,\mathrm{s}}$ \\"),
(r"相对问题一，四维自由度使遮蔽时长从 $1.392\,\mathrm{s}$ 提升至 $4.559\,\mathrm{s}$（$+227\%$）。",
 r"相对问题一，四维自由度使遮蔽时长从 $1.392\,\mathrm{s}$ 提升至 $4.570\,\mathrm{s}$（$+228\%$）。"),
(r"\textbf{引信下界敏感性。}将下界放宽至 $0.5\,\mathrm{s}$ 重优化，最优解 $\tau=4.5590\,\mathrm{s}$、$t_f^{*}=0.99\,\mathrm{s}$——自然最优本身即 $\approx1.0\,\mathrm{s}$，下界取 $1.0\,\mathrm{s}$ 不扭曲结果；下界升至 $1.5\,\mathrm{s}$ 时 $\tau$ 降至 $2.679\,\mathrm{s}$，说明该构型确实需要``尽早起爆''。",
 r"\textbf{引信下界敏感性。}将下界放宽至 $0.5\,\mathrm{s}$ 重优化，自然最优 $t_f^{*}\approx1.0\,\mathrm{s}$、遮蔽时长不变——自然最优本身即 $\approx1.0\,\mathrm{s}$，下界取 $1.0\,\mathrm{s}$ 不扭曲结果；下界升至 $1.5\,\mathrm{s}$ 时 $\tau$ 降至 $2.679\,\mathrm{s}$，说明该构型确实需要``尽早起爆''。"),
(r"""FY1 & $7.996$ & $70.02$ & $0.103$ & $1.050$ & $[1.153,\ 5.716]$ & $4.562$ \\
FY2 & $269.201$ & $136.02$ & $3.608$ & $6.292$ & $[10.193,\ 14.106]$ & $3.913$ \\
FY3 & $143.600$ & $138.00$ & $28.250$ & $10.300$ & $[39.085,\ 41.157]$ & $2.072$ \\
\multicolumn{6}{r}{\textbf{三弹并集有效遮蔽时长}} & $\mathbf{10.547\,\mathrm{s}}$ \\""",
 r"""FY1 & $8.230$ & $70.23$ & $0.013$ & $1.022$ & $[1.424,\ 5.993]$ & $4.570$ \\
FY2 & $310.303$ & $130.98$ & $9.797$ & $3.941$ & $[13.934,\ 17.891]$ & $3.960$ \\
FY3 & $74.050$ & $134.35$ & $22.908$ & $1.003$ & $[23.930,\ 27.077]$ & $3.148$ \\
\multicolumn{6}{r}{\textbf{三弹并集有效遮蔽时长}} & $\mathbf{11.677\,\mathrm{s}}$ \\"""),
]

for old, new in R:
    assert old in s, 'NOT FOUND: ' + old[:50]
    s = s.replace(old, new)
io.open(p, 'w', encoding='utf-8').write(s)
print('第一批', len(R), '处替换完成')

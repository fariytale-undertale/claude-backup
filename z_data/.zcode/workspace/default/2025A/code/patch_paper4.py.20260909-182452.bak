# -*- coding: utf-8 -*-
"""论文 P1 修复补丁：表3/6.4 新解统一、摘要尾数、Q2 灵敏度表、Q4 灵敏度表、文献引用与扩充。"""
import io

P = r'D:\z_data\.zcode\workspace\default\2025A\paper\main.tex'
s = io.open(P, encoding='utf-8').read()

R = []

# ---- P1-1a: 表3 参数行统一为新解 ----
R.append((r"航向角 $\theta$ & $7.809^\circ$（迎向导弹构型） \\",
          r"航向角 $\theta$ & $8.225^\circ$（迎向导弹构型） \\"))

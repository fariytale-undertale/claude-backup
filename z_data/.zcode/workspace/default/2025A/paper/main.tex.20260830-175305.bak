\section{主要程序代码}

以下为判据与求解核心模块全文，其余脚本见支撑材料。

\subsection*{common.py（运动学与遮蔽判据）}
\small
\begin{verbatim}
# （核心节选，完整文件见支撑材料）
G = 9.8; R_CLOUD = 10.0; V_SINK = 3.0; T_EFF = 20.0
V_MISSILE = 300.0; T_FUSE_MIN = 1.0; DROP_GAP_MIN = 1.0
TGT_R = 7.0; TGT_H = 10.0; TGT_MID = [0.0, 200.0, 5.0]

def dist_point_to_segments(p, A, B):
    # 云心到多条件视线段 [导弹位置, 采样点] 的距离（遮蔽判定原语）
    AB = B - A
    denom = np.einsum('ij,ij->i', AB, AB)
    s = np.clip(np.einsum('ij,ij->i', p[None,:] - A, AB)/denom, 0.0, 1.0)
    proj = A + s[:,None]*AB
    return np.linalg.norm(p[None,:] - proj, axis=1)

def _shade_boolean(cloud_c, missile_pts, samples):
    # 体判据：全部采样点视线被云团截断
    for i in range(len(cloud_c)):
        if np.isnan(cloud_c[i,0]): continue
        d = dist_point_to_segments(cloud_c[i],
                np.repeat(missile_pts[i][None,:], len(samples), 0), samples)
        out[i] = bool(np.all(d <= R_CLOUD))
    return out

def bomb_trajectory(uav0, heading_deg, speed, t_drop, t_fuse, t):
    # 投放后抛体：水平 uav0+t*v0，竖直 uav0_z - g/2*(t-t_drop)^2
    ...
def shading_intervals(...):
    # dt 粗扫定位遮蔽区间 + 端点二分 60 次精化
\end{verbatim}

def main():
    wl = json.load(open(WL, encoding="utf-8"))
    nums = wl["numbers"]
    srcs = {}
    for src, keys in GROUPS:
        for k in keys:
            srcs.setdefault(k, []).append(src)
    filled, missing = 0, []
    for k, lst in srcs.items():
        if k in nums:
            nums[k]["src"] = " / ".join(lst)
            filled += 1
        else:
            # 数值等价键（如 0.10 → 0.1）
            hit = None
            for kk in nums:
                try:
                    if abs(float(kk) - float(k)) < 1e-12:
                        hit = kk
                        break
                except ValueError:
                    pass
            if hit:
                nums[hit]["src"] = (nums[hit]["src"] + " / " if not nums[hit]["src"].startswith("TODO") else "") + " / ".join(lst)
                filled += 1
            else:
                missing.append(k)
    json.dump(wl, open(WL, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    todo = [k for k, v in nums.items() if v["src"].startswith("TODO")]
    print("已填来源 %d 条；白名单中不存在的键 %d 个：%s" % (filled, len(missing), missing))
    print("仍为 TODO：%d 条 -> %s" % (len(todo), todo))


if __name__ == "__main__":
    main()

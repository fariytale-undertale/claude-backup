# -*- coding: utf-8 -*-
"""问题三交付输出：最终分带参数（3 位小数）复算 K=24，产出表1/2/3、result3.xlsx、JSON"""
import json

import numpy as np
import pandas as pd

import engine as eg

ROOT = r"D:/z_data/.zcode/workspace/default/2023A"
BANDS = [[5.854, 5.817], [6.154, 5.817], [5.854, 5.817], [5.854, 5.704],
         [5.554, 5.554], [5.854, 5.817]]
CUTS = [-350.0, -200.0, -80.0, 40.0, 160.0, 280.0, 350.01]
TY = -60.41
K = 24

mxy, wh = eg.layout_rows_banded((0.0, TY), [tuple(b) for b in BANDS], CUTS)
n = len(mxy)
z0 = np.maximum(2.0, wh[:, 1] / 2 + 0.05)
res = eg.evaluate_field(mxy, z0, wh[:, 0].copy(), wh[:, 1].copy(), (0.0, TY), K=K, QN=64, cutoff=50.0)
df = res["df"]
A = res["A_total"]
E = float(df["E_kW"].mean()) / 1000.0
u = float(df["E_kW"].mean()) / A
print(f"N={n} A={A:.1f}  K=24: E={E:.4f} MW  u={u:.6f} kW/m2")
print(f"eta={df['eta'].mean():.6f} cos={df['eta_cos'].mean():.6f} "
      f"sb={df['eta_sb'].mean():.6f} tr={df['eta_tr'].mean():.6f}")
assert E >= 60.0

from scipy.spatial import cKDTree
tree = cKDTree(mxy)
pairs = tree.query_pairs(12.5, output_type="ndarray")
d = np.hypot(*(mxy[pairs[:, 0]] - mxy[pairs[:, 1]]).T)
req = np.maximum(wh[pairs[:, 0], 0], wh[pairs[:, 1], 0]) + 5.0
print(f"spacing bad pairs = {int((d < req - 1e-9).sum())} (0 合法)")
print(f"r_max={np.hypot(mxy[:,0],mxy[:,1]).max():.3f} d_tower_min={np.hypot(mxy[:,0],mxy[:,1]-TY).min():.3f} "
      f"z0 in [{z0.min():.3f},{z0.max():.3f}] w in [{wh[:,0].min():.3f},{wh[:,0].max():.3f}] h in [{wh[:,1].min():.3f},{wh[:,1].max():.3f}]")

mon = df.groupby("month_idx", as_index=False).agg(
    eta_cos=("eta_cos", "mean"), eta_sb=("eta_sb", "mean"),
    eta_tr=("eta_tr", "mean"), eta=("eta", "mean"), E_kW=("E_kW", "mean"))
mon["unit"] = mon["E_kW"] / A
pd.DataFrame({
    "日期": [f"{m}月21日" for m in mon["month_idx"] + 1],
    "平均光学效率": mon["eta"], "平均余弦效率": mon["eta_cos"],
    "平均阴影遮挡效率": mon["eta_sb"], "平均截断效率": mon["eta_tr"],
    "单位面积镜面平均输出热功率(kW/m2)": mon["unit"]}
).to_csv(f"{ROOT}/output/tables/q3_table1.csv", index=False, float_format="%.4f")
pd.DataFrame([{
    "年平均光学效率": float(df["eta"].mean()), "年平均余弦效率": float(df["eta_cos"].mean()),
    "年平均阴影遮挡效率": float(df["eta_sb"].mean()), "年平均截断效率": float(df["eta_tr"].mean()),
    "年平均输出热功率(MW)": E, "单位面积镜面年平均输出热功率(kW/m2)": u}]
).to_csv(f"{ROOT}/output/tables/q3_table2.csv", index=False, float_format="%.4f")
pd.DataFrame([{
    "吸收塔位置坐标": f"(0.00, {TY:.2f})", "定日镜尺寸(宽x高/m)": "分带变化(见result3.xlsx)",
    "定日镜安装高度(m)": "分带变化(见result3.xlsx)", "定日镜总面数": n,
    "定日镜总面积(m2)": round(A, 1}]).to_csv(f"{ROOT}/output/tables/q3_table3.csv", index=False)

out = pd.DataFrame({
    "吸收塔x坐标 (m)": np.full(n, 0.0),
    "吸收塔y坐标 (m)": np.full(n, TY),
    "定日镜序号": np.arange(1, n + 1),
    "定日镜宽度 (m)": np.round(wh[:, 0], 3),
    "定日镜高度 (m)": np.round(wh[:, 1], 3),
    "定日镜x坐标 (m)": np.round(mxy[:, 0], 3),
    "定日镜y坐标 (m)": np.round(mxy[:, 1], 3),
    "定日镜z坐标 (m)": np.round(z0, 3)})
out.to_excel(f"{ROOT}/output/result3.xlsx", index=False)
with open(f"{ROOT}/output/tables/q3_summary.json", "w", encoding="utf-8") as f:
    json.dump(dict(bands=BANDS, cuts=CUTS, ty=TY, N=n, A=A, E=E, u=u,
                   eta=dict(eta=float(df["eta"].mean()), cos=float(df["eta_cos"].mean()),
                            sb=float(df["eta_sb"].mean()), tr=float(df["eta_tr"].mean())),
                   monthly=mon.to_dict("records")), f, ensure_ascii=False, indent=1)
print("saved result3.xlsx, q3_table1|2|3.csv, q3_summary.json")

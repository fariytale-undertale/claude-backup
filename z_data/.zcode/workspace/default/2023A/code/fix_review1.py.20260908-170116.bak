# -*- coding: utf-8 -*-
"""评审意见响应补丁 1（A 组纯文字）：
① 摘要/§3.2/§6.2.1 表述软化与叙事校正；② §6.2.2 同心环机制重写（不可公度→径向回退）；
③ §6.2.3 标题；④ §6.2.5 裕度代价 0.45%→0.93% + 口径链；⑤ §6.2.4(4) 外部基准句；
⑥ §7.4 增益口径与未舍入值；⑦ 年均表 u 列 6 位小数（tex + csv）；⑧ §8 缺点补"未证明全局最优"。
§6.2.3 正文、预算表、§8 优点(3) 待 LHS 结果后由补丁 2 处理。"""
import io

ROOT = r"D:/z_data/.zcode/workspace/default/2023A"
TEX = f"{ROOT}/paper/main.tex"


def rd(p):
    with io.open(p, encoding="utf-8") as f:
        return f.read()


def wr(p, s):
    with io.open(p, "w", encoding="utf-8", newline="\n") as f:
        f.write(s)


def rep(s, old, new, tag):
    c = s.count(old)
    assert c == 1, f"[{tag}] expected 1 occurrence, got {c}"
    return s.replace(old, new)


s = rd(TEX)

# ① 摘要 问题二
s = rep(s,
        r"结构探查发现：常规同心环布局在本题约束下年输出热功率上限仅约 57.7 MW、无法达到额定功率，而采用行距为行内间距 $\sqrt{3}/2$ 倍的全局三角错排行网格，使面密度提高约 15.5\%，为可行性的关键。采用``全参数域粗扫—坐标下降精化—随机基线完备性探测''的混合搜索：随机基线找到比结构搜索更优的细窄盆地，最终精化收敛。",
        r"结构探查发现：同心环即便隔环错排，因相邻环镜数不可公度、半步错位无法沿整环维持，径向步长被成对距离约束迫回至 $w+5$，镜面数仅达可用域六边形密铺容量上界的 75\%，年输出热功率上限约 57.7 MW、无法达到额定功率；全局三角错排行网格以等距平行行维持错排、逐行截断贴合圆域边界，镜面数达同一上界的 99.9\%，面密度较环族高 15.5\%，为可行性的关键。采用``结构粗扫—坐标下降精化—随机采样互证''的混合搜索：坐标下降陷入平台后由随机采样找到更优盆地，精化收敛并经高保真复核预留额定裕度。",
        "abs-q2")

# ① 摘要 问题三 增益值
s = rep(s, r"变尺寸设计的增益约为 0.05\%：", r"变尺寸设计的增益仅 0.047\%：", "abs-q3")

# ① §3.2 问题二的分析
s = rep(s,
        r"先做全参数域粗扫定位可行结构，再做坐标下降精化，并以随机基线探测搜索完备性；最终以高保真参数复核并保留额定裕度。",
        r"先做全参数域粗扫确定可行结构与参数量级，再做坐标下降精化，并以大规模随机采样与之互证；最终以高保真参数复核并保留额定裕度。",
        "sec3-q2")

# ① §6.2.1 三段式
s = rep(s,
        r"优化搜索采用三段式：（i）\textbf{全参数域粗扫}------在尺寸、首环半径、间距余量、吸收塔偏移、南界切除等参数的组合网格上穷举，共 84 点，并横向对比两种布局族；（ii）\textbf{坐标下降精化}------从粗扫最优出发逐维尝试固定步长移动、仅接受可行且改进的解；（iii）\textbf{随机基线探测}------在合理箱体内随机采样布局，与结构搜索结果互证，防止漏盆。梯度类算法因目标不可微而排除；种群类算法因单次评估昂贵、有效峰稀疏而仅以小规模随机基线形式保留。",
        r"优化搜索采用三段式：（i）\textbf{全参数域粗扫}------在尺寸、首环半径、间距余量、吸收塔偏移、南界切除等参数的组合网格上穷举，共 84 点，并横向对比两种布局族，其作用是确定可行结构与各参数的合适量级，而非定位全局最优；（ii）\textbf{坐标下降精化}------从粗扫最优出发逐维尝试固定步长移动、仅接受可行且改进的解，单维移动难以沿约束边界的细长脊前进，易陷入局部平台；（iii）\textbf{随机采样互证}------在合理箱体内以拉丁超立方采样大规模随机布局，承担跳出局部平台与检验遗漏盆地的作用。梯度类算法因目标不可微而排除；种群类算法因单次评估昂贵、有效峰稀疏而不采用，其全局探索能力由随机采样承担。",
        "sec6-2-1")

# ② §6.2.2 同心环机制重写
s = rep(s,
        r"粗扫结果给出一个决定性事实：同心环族在 $w{=}6{\sim}8$ m 全尺寸范围内的年输出热功率上限仅约 57.7 MW，\textbf{无法达到 60 MW 额定功率}。原因在于同心环的环间距受``相邻环镜对角距离 $\ge w+5$''约束只能取 $d_R\ge w+5$，而三角错排允许行距压缩至 $(\sqrt{3}/2)(w{+}5)$------\textbf{全局错排行网格将面密度提高约 15.5\%}，多个尺寸配置的年输出热功率跃升至 60--63.5 MW 区间，额定约束变为可行。切除深南低效弧段的南界切除扫描与吸收塔南移扫描均未改善目标，说明在本题约束下南侧镜像仍为净正贡献，最优结构是\textbf{全场致密错排行网格}。",
        r"粗扫结果给出一个决定性事实：同心环族在 $w{=}6{\sim}8$ m 全尺寸范围内的年输出热功率上限仅约 57.7 MW，\textbf{无法达到 60 MW 额定功率}。需要说明，探查中的同心环族并非对齐环：它已采用隔环错位半步、标称径向步长 $(\sqrt{3}/2)(w{+}5)$，并逐环在候选相位中选取与前一环最近距离最大者。在等间距平行行中，半步错排使相邻行任意两镜距离恒为 $\sqrt{d_y^2+(p/2)^2}=p$，错排可全场维持；但同心环的周长逐环增大，镜数 $n_k=\lfloor\pi/\arcsin((w{+}5)/2R_k)\rfloor$ 逐环不同（实测 58、65、71、77、$\cdots$），相邻两环的方位向间距不可公度，半步错位无法沿整环维持------相位差沿圆周漂移后总会在某处趋于径向对齐，成对距离约束 $\ge w+5$ 便迫使径向步长回退。实测 23 个环的径向步长全部落在 10.85$\sim$10.91 m，均值 10.90 m，与 $w{+}5=10.854$ m 相差仅 0.4\%，而非标称的 9.40 m：\textbf{行网格相对环族的径向密度优势为 15.9\%，与三角格对正方格的理论比值 $2/\sqrt{3}=1.155$ 一致}。

以每面镜占据 $(\sqrt{3}/2)(w{+}5)^2$ 的六边形密铺密度计，可用域（半径 350 m 圆内扣除塔周 100 m 保留区，面积 353429 m$^2$）的容量上界约 3464 面。行网格逐行截断、贴合圆域边界，布置 3462 面，达上界的 99.9\%；环族仅 2613 面，为 75.4\%，其中径向回退贡献约 14 个百分点，以吸收塔为圆心的环无法覆盖场域北侧新月区（面积 42234 m$^2$）再贡献约 11 个百分点。相同设计参数下环族年输出热功率 48.1 MW，行网格 60.7 MW（$K{=}12$ 口径）；即便改以场域中心为圆心消除新月区损失，仅径向回退一项也使环族容量不超过约 2990 面、年输出热功率约 55 MW，仍低于额定，与粗扫全域上限 57.7 MW 一致。可见可行性的关键在于\textbf{哪种规则结构能在有限圆域内实现六边形密铺密度}：三角错排行网格以等距平行行做到了这一点，使多个尺寸配置的年输出热功率跃升至 60--63.5 MW 区间，额定约束变为可行。切除深南低效弧段的南界切除扫描与吸收塔南移扫描均未改善目标，说明在本题约束下南侧镜像仍为净正贡献，最优结构是\textbf{全场致密错排行网格}。",
        "sec6-2-2")

# ③ §6.2.3 标题
s = rep(s, r"\subsubsection{精化与搜索完备性}", r"\subsubsection{精化与随机采样互证}", "sec6-2-3-title")

# ④ §6.2.5 裕度代价 + 口径链
s = rep(s,
        r"以 $K=24$ 高保真参数复核最优设计，年输出热功率 60.058 MW，虽满足额定但裕度仅 0.1\%，与模型不确定度同量级；故将镜高增加 0.10 m，以 $0.45\%$ 的目标值代价换取 $0.94\%$ 的额定裕度。最终设计见表 \ref{tab:q2d}，",
        r"以 $K=24$ 高保真参数复核精化收敛设计，年输出热功率 60.058 MW，虽满足额定但裕度仅 0.1\%，与模型不确定度同量级；故将镜高增加 0.10 m，以 $0.93\%$ 的目标值代价换取 $0.94\%$ 的额定裕度。这里需说明两个口径：精化收敛值 $u^*=0.5331$ 为 $K=12$ 搜索口径，同一设计在 $K=24$ 下为 0.5323，保真度差 $0.15\%$；加高购裕后为 0.5274（$K=24$），即最终交付值。搜索过程中的 0.5322、0.5331 与最终的 0.5274 分属不同口径与不同设计阶段，并无矛盾。最终设计见表 \ref{tab:q2d}，",
        "sec6-2-5")

# ⑤ §6.2.4(4) 外部基准句
s = rep(s,
        r"环形族不可行而行网格可行的结构对比，解释了达到额定的关键。",
        r"规则结构能否在有限圆域内逼近六边形密铺密度解释了达到额定的关键：错排同心环达容量上界的 75\%，行网格达 99.9\%。",
        "sec6-2-4-bench")

# ⑥ §7.4 增益口径
s = rep(s,
        r"与问题二相比 $u$ 提升 $+0.05\%$，搜索口径 $K=12$ 下为 $+0.15\%$：",
        r"与问题二相比 $u$ 由 0.527352 提升至 0.527599，按未舍入值计为 $+0.047\%$；搜索口径 $K=12$ 下由 0.53311 提升至 0.53393，为 $+0.15\%$：",
        "sec7-4-gain")
s = rep(s,
        r"这一结果同时验证了问题二统一尺寸设计已接近该约束下的结构最优。",
        r"这一结果说明问题二统一尺寸设计在该约束下已属较优，但不能据此断言全局最优。",
        "sec7-4-opt")

# ⑧ §8 缺点(4)
s = rep(s,
        r"\item 布局优化限定在规则结构族内，逐面自由优化理论上仍有微小改进空间，但评估成本高出数个量级。",
        r"\item 布局优化限定在规则结构族内，且未证明全局最优：坐标下降易陷局部平台，随机采样与结构搜索互证只能显著降低、不能消除遗漏更优盆地的可能；逐面自由优化理论上仍有微小改进空间，但评估成本高出数个量级。",
        "sec8-cons")

wr(TEX, s)

# ⑦ 年均表 u 列精度（tex 表体 + csv 数据）
for p, old, new in [
    (f"{ROOT}/paper/tab_q2_a.tex", "& 0.5274 \\\\", "& 0.527352 \\\\"),
    (f"{ROOT}/paper/tab_q3_a.tex", "& 0.5276 \\\\", "& 0.527599 \\\\"),
    (f"{ROOT}/output/tables/q2_table2.csv", ",60.5667,0.5274", ",60.5667,0.527352"),
    (f"{ROOT}/output/tables/q3_table2.csv", ",60.6171,0.5276", ",60.6171,0.527599"),
]:
    t = rd(p)
    t = rep(t, old, new, p.split("/")[-1])
    wr(p, t)

print("patch1 OK")

# -*- coding: utf-8 -*-
"""论文素材 v2：流程图 + 程序化生成 LaTeX 表格（无嵌套 tabular，环境兼容版）"""
import json

import pandas as pd

import figs as fg
from matplotlib.patches import FancyArrowPatch, FancyBboxPatch

ROOT = r"D:/z_data/.zcode/workspace/default/2023A"
OUT = f"{ROOT}/paper"

# ---------- 流程图（分层逻辑流：层组中心对齐、层间水平箭头、分支正交折线无斜线） ----------
fig, ax = fg.plt.subplots(figsize=(12.8, 5.0))
ax.set_xlim(0, 170)
ax.set_ylim(0, 66)
ax.axis("off")
MID = 34.0  # 层组共用垂直中心，层间箭头水平


def gbox(x0, y0, x1, y1, label):
    ax.add_patch(FancyBboxPatch((x0, y0), x1 - x0, y1 - y0, boxstyle="round,pad=0.4",
                                fc="#fdf1e3", ec="k", lw=1.1, linestyle="--"))
    ax.text((x0 + x1) / 2, y1 - 3.0, label, ha="center", va="center",
            fontsize=10.5, weight="bold")


def box(x0, y0, x1, y1, label, fc="white", fs=9.0):
    ax.add_patch(FancyBboxPatch((x0, y0), x1 - x0, y1 - y0, boxstyle="round,pad=0.3",
                                fc=fc, ec="k", lw=0.9))
    ax.text((x0 + x1) / 2, (y0 + y1) / 2, label, ha="center", va="center", fontsize=fs)


def arrow(x0, y0, x1, y1):
    ax.add_patch(FancyArrowPatch((x0, y0), (x1, y1), arrowstyle="-|>",
                                 mutation_scale=15, color="k", lw=1.2))


def oarrow(pts, label=None, lxy=(0, 1.0)):
    """正交折线箭头：点列须横平竖直，箭头落在末段"""
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    ax.plot(xs, ys, color="k", lw=1.2, solid_capstyle="round")
    ax.add_patch(FancyArrowPatch(pts[-2], pts[-1], arrowstyle="-|>",
                                 mutation_scale=15, color="k", lw=1.2))
    if label:
        ax.text(pts[-2][0] + (pts[-1][0] - pts[-2][0]) / 2 + lxy[0],
                pts[-2][1] + (pts[-1][1] - pts[-2][1]) / 2 + lxy[1],
                label, ha="center", va="bottom", fontsize=9.2)


# 层 1：设定决策变量（5 框铺满层高）
gbox(2, 6, 30, 62, "设定决策变量")
box(4, 46, 28, 52, "问题一：附件给定布局")
box(4, 36.4, 28, 42.4, "问题二：吸收塔位置")
box(4, 26.8, 28, 32.8, "统一尺寸与安装高度")
box(4, 17.2, 28, 23.2, "问题二：行网格间距")
box(4, 7.6, 28, 13.6, "问题三：分带宽×高")
# 层 2：通用几何建模（3 框，组高贴内容，组中心 MID）
gbox(37, 18, 63, 50, "通用几何建模")
box(39, 39, 61, 45, "太阳位置与 DNI")
box(39, 30.5, 61, 36.5, "镜面法向与四角点")
box(39, 22, 61, 28, "子格划分 12×12")
# 层 3：效率判定函数（3 框，组高贴内容，组中心 MID）
gbox(70, 18, 97, 50, "效率判定函数")
box(72, 39, 95, 45, "余弦效率")
box(72, 30.5, 95, 36.5, "阴影遮挡：光线-矩形求交")
box(72, 22, 95, 28, "截断：束锥卷积积分")
# 年均目标函数（中央节点）
box(103, 29, 124, 39, "60 时点年平均效率\n与输出热功率 E、u", fc="#fff2cc", fs=9.4)
# 分问题求解分支
box(132, 48, 150, 56, "输入附件给定布局", fc="#e2f0e0", fs=8.6)
box(132, 29, 150, 39, "行网格粗扫+坐标下降\n+随机基线", fc="#e2f0e0", fs=8.6)
box(132, 10, 150, 20, "分带尺寸坐标下降", fc="#e2f0e0", fs=8.6)
# 输出
box(154, 29, 168, 39, "输出\n结果", fc="#dbe9f9", fs=9.4)
# 层间水平箭头（各层中心 MID 对齐）
arrow(30, MID, 37, MID)
arrow(63, MID, 70, MID)
arrow(97, MID, 103, MID)
# 分支正交箭头（标注问题号，全部横平竖直）
arrow(124, MID, 132, MID)
oarrow([(113.5, 39), (113.5, 52), (132, 52)], label="问题 1", lxy=(-4, 0.4))
oarrow([(113.5, 29), (113.5, 16), (132, 16)], label="问题 3", lxy=(-4, 0.4))
# 分支→输出（正交）
arrow(150, MID, 154, MID)
oarrow([(150, 52), (157, 52), (157, 39)])
oarrow([(150, 16), (157, 16), (157, 29)])
fg.save(fig, "global_flow.png")


# ---------- 表格（无嵌套 tabular） ----------
def table1_tex(csv, fout):
    d = pd.read_csv(csv)
    if "month" in d.columns:
        d = d.rename(columns={"month": "日期"})
    col = "单位面积镜面平均输出热功率(kW/m2)"
    lines = ["日期 & 平均光学效率 & 平均余弦效率 & 平均阴影遮挡效率 & 平均截断效率 & 单位面积输出/(kW/m2) \\\\"]
    for _, r in d.iterrows():
        lines.append(f"{r['日期']} & {r['平均光学效率']:.4f} & {r['平均余弦效率']:.4f} & "
                     f"{r['平均阴影遮挡效率']:.4f} & {r['平均截断效率']:.4f} & {r[col]:.4f} \\\\")
    with open(fout, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print("wrote", fout)


def table2_tex(csv, fout):
    d = pd.read_csv(csv).iloc[0]
    rows = [("年平均光学效率", f"{d['年平均光学效率']:.4f}"),
            ("年平均余弦效率", f"{d['年平均余弦效率']:.4f}"),
            ("年平均阴影遮挡效率", f"{d['年平均阴影遮挡效率']:.4f}"),
            ("年平均截断效率", f"{d['年平均截断效率']:.4f}"),
            ("年平均输出热功率/MW", f"{d['年平均输出热功率(MW)']:.4f}"),
            ("单位面积镜面年平均输出热功率/(kW/m2)", f"{d['单位面积镜面年平均输出热功率(kW/m2)']:.4f}")]
    lines = ["指标 & 数值 \\\\"]
    lines += [f"{k} & {v} \\\\" for k, v in rows]
    with open(fout, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print("wrote", fout)


table1_tex(f"{ROOT}/output/tables/q1_table1.csv", f"{OUT}/tab_q1_m.tex")
table2_tex(f"{ROOT}/output/tables/q1_table2.csv", f"{OUT}/tab_q1_a.tex")
table1_tex(f"{ROOT}/output/tables/q2_table1.csv", f"{OUT}/tab_q2_m.tex")
table2_tex(f"{ROOT}/output/tables/q2_table2.csv", f"{OUT}/tab_q2_a.tex")
table1_tex(f"{ROOT}/output/tables/q3_table1.csv", f"{OUT}/tab_q3_m.tex")
table2_tex(f"{ROOT}/output/tables/q3_table2.csv", f"{OUT}/tab_q3_a.tex")

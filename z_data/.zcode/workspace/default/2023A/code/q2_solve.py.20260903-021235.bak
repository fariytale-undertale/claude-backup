# -*- coding: utf-8 -*-
"""问题二：环形布局族参数优化
theta = (tx, ty, w, h, z0, R0, gaz, gr)
布局：以塔为心的同心环，环距 dR=w+5+gr（跨环最近距离>=w+5），同环弦距>=w+5+gaz，
隔环半 pitch 错位；镜中心 |p|<=350 且 |p-tower|>100。
目标：max u = E_annual/A_total  s.t. E_annual >= 60 MW
用法：python q2_solve.py coarse|tower|refine|final
"""
import json
import sys
import time

import numpy as np

import engine as eg
import figs as fg

ROOT = r"D:/z_data/.zcode/workspace/default/2023A"
STATE = f"{ROOT}/output/q2_state.json"
RATED = 60.0


def load():
    with open(STATE, encoding="utf-8") as f:
        return json.load(f)


def save(s):
    with open(STATE, "w", encoding="utf-8") as f:
        json.dump(s, f, ensure_ascii=False)


def eval_theta(theta, K=12, want_detail=False):
    tx, ty, w, h, z0, R0, gaz, gr = theta
    mxy, n = eg.layout_rings((tx, ty), w, h, z0, R0, w + 5.0 + gr, gaz)
    if mxy is None or n < 10:
        return None
    res = eg.evaluate_field(mxy, np.full(n, z0), np.full(n, w), np.full(n, h), (tx, ty),
                            K=K, QN=64, cutoff=50.0)
    E = float(res["df"]["E_kW"].mean()) / 1000.0
    A = res["A_total"]
    u = float(res["df"]["E_kW"].mean()) / A
    rec = dict(theta=[round(v, 4) for v in theta], n=int(n), A=round(A, 1),
               E=round(E, 4), u=round(u, 6), feasible=bool(E >= RATED))
    if want_detail:
        rec["res"] = res
        rec["mxy"] = mxy
    return rec


def main(stage):
    if stage == "coarse":
        recs = []
        t0 = time.time()
        sizes = [(w, w) for w in (6.0, 6.5, 7.0, 7.5, 8.0)] + [(8.0, 7.0), (7.0, 6.0)]
        for (w, h) in sizes:
            z0 = max(2.0, h / 2 + 0.5)
            for R0 in (103.0, 110.0, 118.0):
                for gaz in (0.0, 1.5):
                    for gr in (0.0, 1.5):
                        th = [0.0, 0.0, w, h, z0, R0, gaz, gr]
                        r = eval_theta(th)
                        if r:
                            recs.append(r)
        recs.sort(key=lambda r: (not r["feasible"], -r["u"]))
        save({"coarse": recs})
        print(f"coarse done {len(recs)} layouts in {time.time()-t0:.0f}s")
        for r in recs[:12]:
            print(f"  u={r['u']:.4f} E={r['E']:6.2f} N={r['n']:5d} A={r['A']:8.0f} "
                  f"feas={r['feasible']} theta={r['theta']}")
        print("... worst-u feasible & best infeasible:")
        fs = [r for r in recs if r["feasible"]]
        print("  n_feasible =", len(fs))
        inf = [r for r in recs if not r["feasible"]]
        if inf:
            inf.sort(key=lambda r: -r["E"])
            print(f"  best infeasible E={inf[0]['E']:.2f} theta={inf[0]['theta']}")

    elif stage == "tower":
        s = load()
        feas = [r for r in s["coarse"] if r["feasible"]]
        top = feas[:3] if feas else sorted(s["coarse"], key=lambda r: -r["E"])[:3]
        seeds = {tuple(r["theta"]) for r in top}
        recs = []
        for st in seeds:
            tx0, ty0, w, h, z0, R0, gaz, gr = st
            for ty in (-30.0, -70.0, -110.0, -150.0, -190.0):
                for tx in (0.0, -20.0, 20.0):
                    r = eval_theta([tx, ty, w, h, z0, R0, gaz, gr])
                    if r:
                        recs.append(r)
        s["tower"] = recs
        pool = sorted(s["coarse"] + recs, key=lambda r: (not r["feasible"], -r["u"]))
        s["pool_top"] = pool[:15]
        save(s)
        print(f"tower done {len(recs)} evals")
        for r in pool[:10]:
            print(f"  u={r['u']:.4f} E={r['E']:6.2f} N={r['n']:5d} A={r['A']:8.0f} "
                  f"theta={r['theta']}")

    elif stage == "refine":
        s = load()
        best = dict(s["pool_top"][0])
        trace = [dict(i=0, u=best["u"], E=best["E"], theta=best["theta"], acc=True)]
        steps = [40.0, 20.0, 10.0, 5.0]          # ty/tx 步长
        steps_r = [4.0, 2.0, 1.0]                 # R0/gaz/gr 步长
        steps_s = [0.5, 0.25]                     # 尺寸步长
        ei = 0
        for phase in range(3):
            improved = False
            for pi, kind in enumerate(["ty", "tx", "R0", "gaz", "gr", "w", "h", "z0"]):
                st = best["theta"][:]
                if kind in ("ty", "tx"):
                    cand = []
                    for d in (+1, -1):
                        v = st[0 if kind == "tx" else 1] + d * steps[min(phase, len(steps) - 1)]
                        if kind == "ty":
                            v = min(-0.0, max(-200.0, v))
                        else:
                            v = max(-30.0, min(30.0, v))
                        c = st[:]; c[0 if kind == "tx" else 1] = v
                        cand.append(c)
                elif kind == "R0":
                    cand = []
                    for d in (+1, -1):
                        c = st[:]; c[5] = min(130.0, max(101.0, c[5] + d * steps_r[min(phase, 2)]))
                        cand.append(c)
                elif kind in ("gaz", "gr"):
                    cand = []
                    for d in (+1, -1):
                        c = st[:]
                        j = 6 if kind == "gaz" else 7
                        c[j] = max(0.0, c[j] + d * steps_r[min(phase, 2)])
                        cand.append(c)
                else:
                    cand = []
                    for d in (+1, -1):
                        c = st[:]
                        if kind == "w":
                            c[2] = min(8.0, max(3.0, c[2] + d * steps_s[min(phase, 1)]))
                        elif kind == "h":
                            c[3] = min(c[2], max(2.0, c[3] + d * steps_s[min(phase, 1)]))
                        else:
                            c[4] = min(6.0, max(max(2.0, c[3] / 2 + 0.05), c[4] + d * 0.5))
                        cand.append(c)
                for c in cand:
                    ei += 1
                    r = eval_theta(c)
                    if r and r["feasible"] and r["u"] > best["u"] + 1e-6:
                        best = r
                        improved = True
                    trace.append(dict(i=ei, u=r["u"] if r else None, E=r["E"] if r else None,
                                      theta=c, acc=bool(r and r["feasible"] and r is best)))
            if not improved and phase >= 1:
                break
        s["refine_best"] = {k: v for k, v in best.items() if k not in ("res", "mxy")}
        s["trace"] = trace
        save(s)
        print(f"refine done, {ei} evals, best u={best['u']:.5f} E={best['E']:.3f} "
              f"N={best['n']} theta={best['theta']}")

    elif stage == "final":
        s = load()
        best = s["refine_best"]
        th = best["theta"]
        # K=24 高保真确认
        r24 = eval_theta(th, K=24, want_detail=True)
        print(f"K=24 confirm: u={r24['u']:.5f} E={r24['E']:.3f} N={r24['n']} A={r24['A']:.0f}")
        dens = 0
        while r24["E"] < RATED + 0.2 and dens < 6:
            th = th[:]
            th[6] = max(0.0, th[6] - 0.25)
            th[7] = max(0.0, th[7] - 0.25)
            dens += 1
            r24 = eval_theta(th, K=24, want_detail=True)
            print(f"  densify x{dens}: gaz/gr -> {th[6]}/{th[7]}: E={r24['E']:.3f} u={r24['u']:.5f}")
        s["final"] = dict(theta=th, u=r24["u"], E=r24["E"], n=r24["n"], A=r24["A"],
                          feas=r24["feasible"])
        save(s)
        res = r24["res"]; mxy = r24["mxy"]; df = res["df"]; A = r24["A"]
        eta_m = res["eta_mirror_TN"].mean(axis=0)
        print(f"FINAL Q2: tower=({th[0]:.1f},{th[1]:.1f}) size={th[2]}x{th[3]} z0={th[4]} "
              f"R0={th[5]} gaz={th[6]} gr={th[7]} N={r24['n']} A={A:.0f} "
              f"E={r24['E']:.3f} MW  u={r24['u']:.5f} kW/m2")
        print(f"  eta={df['eta'].mean():.5f} cos={df['eta_cos'].mean():.5f} "
              f"sb={df['eta_sb'].mean():.5f} tr={df['eta_tr'].mean():.5f}")
        print(f"  per-mirror eta: min={eta_m.min():.4f} p10={np.percentile(eta_m,10):.4f} "
              f"mean={eta_m.mean():.4f}")
        # 间距合规复核（最近邻 >= w+5）
        from scipy.spatial import cKDTree
        dnn, _ = cKDTree(mxy).query(mxy, k=2)
        print(f"  min NN spacing={dnn[:,1].min():.3f} (need >= {th[2]+5:.1f}) "
              f"r_max={np.hypot(mxy[:,0],mxy[:,1]).max():.2f} "
              f"d_tower_min={np.hypot(mxy[:,0]-th[0],mxy[:,1]-th[1]).min():.2f}")
        mon = df.groupby("month_idx", as_index=False).agg(
            eta_cos=("eta_cos", "mean"), eta_sb=("eta_sb", "mean"),
            eta_tr=("eta_tr", "mean"), eta=("eta", "mean"), E_kW=("E_kW", "mean"))
        mon["unit"] = mon["E_kW"] / A
        fg.plot_layout(mxy, eta_m, (th[0], th[1]), "q2_layout_eta.png",
                       "问题二优化布局及逐镜年平均光学效率", sizes=13)
        fg.plot_components(mon, "q2_components_month.png", "问题二 逐月平均效率分量")
        fg.plot_power(df, "q2_power_time.png", "问题二 定日镜场输出热功率")
        sunv, _, _, _ = eg.build_times()
        i0 = int(np.argmin(np.abs(np.hypot(mxy[:, 0] - th[0] - 170, mxy[:, 1] - th[1] + 130))))
        fg.scene_3d(mxy, np.full(r24["n"], th[4]), (th[0], th[1]), sunv[2 * 5 + 1],
                    "scene_3d_q2.png", sample_idx=i0, label="（问题二）")
        np.save(f"{ROOT}/data/q2_mirrors.npy", mxy)
        mon.to_csv(f"{ROOT}/output/tables/q2_monthly.csv", index=False)
        # 收敛轨迹
        tr = s.get("trace", [])
        if tr:
            xs = [t["i"] for t in tr]
            us = [t["u"] if t["u"] else np.nan for t in tr]
            acc = [t for t in tr if t.get("acc")]
            import matplotlib.pyplot as plt
            fig, ax = plt.subplots(figsize=(7.0, 3.8))
            ax.plot(xs, us, ".", ms=2.5, color="lightsteelblue", label="全部评估点")
            ax.plot([t["i"] for t in acc], [t["u"] for t in acc], "o", ms=4,
                    color="crimson", label="当前最优更新")
            ax.set_xlabel("累计评估次数"); ax.set_ylabel("单位面积年平均输出热功率 (kW/m²)")
            ax.set_title("问题二 参数精化收敛轨迹（约束 E≥60 MW）")
            ax.grid(alpha=0.3, ls=":"); ax.legend()
            fg.save(fig, "q2_convergence.png")


if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else "coarse")

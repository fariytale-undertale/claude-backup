# -*- coding: utf-8 -*-
"""问题4：p=1.7 m 螺线的 S 形调头曲线。
- 基线 2:1 曲线几何求解与检验
- 填写 output/result4.xlsx（t=-100..100）
- "能否变短"：保持三相切的曲线族 L(R2) 求最短
产出：figures/fig_q4_*.png、output/tables/q4_paper_table.xlsx。"""
import numpy as np
import openpyxl
import os, re, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dragon_core import (walk_chain_series, chain_points, chain_speeds,
                         chord_residual, S_arc, spiral_point)
import turn_geom as tg
from figures_common import save_fig, COLORS
import matplotlib.pyplot as plt

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ATT = "D:/pdf/国赛/国赛历年真题/2024年赛题/A题/附件"
t_start = time.time()

print(f"[几何] theta_b = {tg.th_b:.6f} rad, A = ({tg.A[0]:.6f}, {tg.A[1]:.6f}), "
      f"行进方向 T = ({tg.T_in[0]:.6f}, {tg.T_in[1]:.6f})")
print(f"[几何] S(theta_b) = {float(S_arc(tg.th_b, tg.b)):.6f} m（盘入螺线上 A 的弧位）")

base = tg.find_baseline()
tp = base["tp"]
L_base = base["L"]
d1, d2 = base["sweep"]
print(f"\n[基线] 2:1 S 曲线: R2={base['R2']:.6f}, R1={base['R1']:.6f}, "
      f"切点 T1=({base['T1'][0]:.6f}, {base['T1'][1]:.6f}), 总长 L={L_base:.6f} m")
print(f"[基线] 弧扫角 = ({np.degrees(d1):.2f}°, {np.degrees(d2):.2f}°), "
      f"弧长 = ({base['L1']:.6f}, {base['L2']:.6f}) m")
print(f"[检验] 端点切向连续性指标 = {base['g1']:.6f} (应=1)")
print(f"[检验] |A| = {np.linalg.norm(tg.A):.6f} (应=4.5); 曲线最大半径 rmax = "
      f"{base['rmax']:.6f} (<=4.5, 盘内)")
assert abs(np.linalg.norm(tg.A) - 4.5) < 1e-12 and base["rmax"] <= 4.5 + 1e-6

# ---------- result4 填写（基线路径，v0=1，t 即头部弧位 mu） ----------
ts4 = np.arange(-100, 101, dtype=float)
mu4 = walk_chain_series(tp, ts4)
X4 = chain_points(tp, mu4)
sd4 = chain_speeds(tp, mu4, 1.0)
v4 = np.abs(sd4)
res4 = chord_residual(tp, mu4)
print(f"\n[检验] result4 批量弦长残差 = {res4:.3e}")
assert res4 < 1e-8
h = 1e-6
for t_chk in (-50.0, 0.0, 50.0):
    Xp = chain_points(tp, walk_chain_series(tp, np.array([t_chk + h])))[0]
    Xm = chain_points(tp, walk_chain_series(tp, np.array([t_chk - h])))[0]
    vfd = np.linalg.norm(Xp - Xm, axis=1) / (2 * h)
    rel = np.abs(v4[int(t_chk) + 100] - vfd) / vfd
    print(f"[检验] t={t_chk:+.0f}s 递推vs差分 max rel err = {rel.max():.2e}")
    assert rel.max() < 1e-4
print(f"[检验] t=0 龙头位置 = ({X4[100, 0, 0]:.6f}, {X4[100, 0, 1]:.6f}) 应=A")
assert np.linalg.norm(X4[100, 0] - tg.A) < 1e-9


def handle_of(lab):
    if lab.startswith("龙头"):
        return 0
    if lab.startswith("龙尾（后）"):
        return 223
    if lab.startswith("龙尾"):
        return 222
    return int(re.match(r"^第(\d+)节龙身", lab).group(1))


wb = openpyxl.load_workbook(f"{ATT}/result4.xlsx")
ws_pos, ws_vel = wb["位置"], wb["速度"]
tcol, tcolv = {}, {}
for c in range(2, ws_pos.max_column + 1):
    tcol[int(str(ws_pos.cell(row=1, column=c).value).replace("s", "").strip())] = c
    tcolv[int(str(ws_vel.cell(row=1, column=c).value).replace("s", "").strip())] = c
for r in range(2, ws_pos.max_row + 1):
    k = handle_of(ws_pos.cell(row=r, column=1).value)
    isy = "y" in ws_pos.cell(row=r, column=1).value
    for t, c in tcol.items():
        ws_pos.cell(row=r, column=c).value = round(float(X4[t, k, 1 if isy else 0]), 6) + 0.0
    kv = handle_of(ws_vel.cell(row=r, column=1).value)
    for t, c in tcolv.items():
        ws_vel.cell(row=r, column=c).value = round(float(v4[t, kv]), 6) + 0.0
wb.save(f"{ROOT}/output/result4.xlsx")
print("saved:", f"{ROOT}/output/result4.xlsx")

paper_rows = [("龙头", 0), ("第1节龙身", 1), ("第51节龙身", 51), ("第101节龙身", 101),
              ("第151节龙身", 151), ("第201节龙身", 201), ("龙尾（后）", 223)]
paper_ts = [-100, -50, 0, 50, 100]
wb_out = openpyxl.Workbook()
ws1 = wb_out.active; ws1.title = "位置"
ws1.append([""] + [f"{t} s" for t in paper_ts])
for name, k in paper_rows:
    ws1.append([f"{name}x (m)"] + [round(float(X4[t + 100, k, 0]), 6) for t in paper_ts])
    ws1.append([f"{name}y (m)"] + [round(float(X4[t + 100, k, 1]), 6) for t in paper_ts])
ws2 = wb_out.create_sheet("速度")
ws2.append([""] + [f"{t} s" for t in paper_ts])
for name, k in paper_rows:
    ws2.append([f"{name} (m/s)"] + [round(float(v4[t + 100, k]), 6) for t in paper_ts])
wb_out.save(f"{ROOT}/output/tables/q4_paper_table.xlsx")
print("saved:", f"{ROOT}/output/tables/q4_paper_table.xlsx")
print("\n== 问题4 表（基线 2:1 曲线） ==")
for name, k in paper_rows:
    print(f"{name:>10} " + " | ".join(
        f"t={t:+5d}: ({X4[t+100,k,0]:>8.4f},{X4[t+100,k,1]:>8.4f}) v={v4[t+100,k]:.4f}"
        for t in paper_ts))

# ---------- "能否变短"：曲线族不变量（命题 P6 修正版） ----------
S_fam, D_fam, L_fam = tg.family_constants()
print(f"\n[族] 曲线族不变量: R1+R2 = S = {S_fam:.6f} m（常量）, "
      f"两弧扫角 = {np.degrees(D_fam):.4f}°（常量）")
print(f"[族] 闭式长度 L = S·Δθ = {L_fam:.6f} m（与基线数值 L 相差 "
      f"{abs(L_fam - L_base):.2e}）")
assert abs(L_fam - L_base) < 1e-9
# 数值验证：族内取 30 个半径分配，L 应逐点相同
R2_grid = np.linspace(0.10, S_fam - 0.10, 30)
L_vals = []
rmax_vals = []
for R2 in R2_grid:
    sol = tg.family_member(float(R2), sample_n=6000)
    assert sol is not None, f"族成员 R2={R2:.3f} 无效"
    L_vals.append(sol["L"])
    rmax_vals.append(sol["rmax"])
L_vals = np.array(L_vals)
dev = float(np.max(np.abs(L_vals - L_base)))
print(f"[检验] 族内 30 点长度不变性: max|L(R2) - L| = {dev:.2e}（应≈0）")
print(f"[检验] 全部族成员位于调头空间内: max rmax = {max(rmax_vals):.6f} <= 4.5")
print(f"[结论] 不能。保持与两螺线及两弧之间相切、切点 A/A' 固定时，"
      f"调头曲线长度恒为 L = S·Δθ = {L_fam:.6f} m，与半径分配无关，"
      f"故不存在更短的调整方案。")

np.savez(f"{ROOT}/output/q4_geom.npz", R2_base=base["R2"], L_base=L_base,
         S_fam=S_fam, D_fam=D_fam, L_fam=L_fam,
         R2_grid=R2_grid, L_vals=L_vals)

# ---------- 图 ----------
fig, ax = plt.subplots(figsize=(8.6, 8.6))
th_out = np.linspace(tg.th_b, tg.th_b + 40, 3000)
pin = spiral_point(th_out, tg.b)
ax.plot(pin[:, 0], pin[:, 1], color="0.8", lw=0.8)
ax.plot(-pin[:, 0], -pin[:, 1], color="0.8", lw=0.8, label="盘入/盘出螺线")
th_sm = np.linspace(1e-6, tg.th_b, 2000)
psp = spiral_point(th_sm, tg.b)
ax.plot(psp[:, 0], psp[:, 1], color="0.92", lw=0.5)
ax.plot(-psp[:, 0], -psp[:, 1], color="0.92", lw=0.5)
for R2, c, lw in ((0.20, "#2ca02c", 1.3), (base["R2"], "#1f77b4", 2.0), (4.30, "#ff7f0e", 1.3)):
    sol = tg.family_member(R2, sample_n=8000)
    mus = np.linspace(0, sol["L"], 3000)
    pts = sol["tp"].point(mus)
    ax.plot(pts[:, 0], pts[:, 1], color=c, lw=lw,
            label=f"R2={R2:.2f}, R1={sol['R1']:.2f}（L={sol['L']:.4f} m）")
circ = plt.Circle((0, 0), tg.R_DISK, fill=False, color="#d62728", ls="--", lw=1.1,
                  label="调头空间边界（r=4.5 m）")
ax.add_patch(circ)
for pt, nm in ((tg.A, "A"), (tg.Ap, "A'"), (base["T1"], "T1（基线切点）")):
    ax.plot([pt[0]], [pt[1]], "k.", ms=7)
    ax.annotate(nm, pt, textcoords="offset points", xytext=(5, 5), fontsize=10)
ax.plot(0, 0, "k+", ms=10)
ax.set_aspect("equal")
ax.set_xlabel("x (m)"); ax.set_ylabel("y (m)")
ax.set_xlim(-6.5, 6.5); ax.set_ylim(-6.5, 6.5)
ax.set_title("调头曲线族：形状可调而长度不变（L = S·Δθ）")
ax.legend(fontsize=8, loc="upper right")
save_fig(fig, "fig_q4_geom.png")

fig, ax = plt.subplots(figsize=(7.4, 4.4))
ax.plot(R2_grid, L_vals, "o-", color="#1f77b4", ms=4, lw=1.1)
ax.axhline(L_base, color="#d62728", ls="--", lw=1.0,
           label=f"基线 2:1 曲线 L = {L_base:.6f} m")
ax.set_xlabel("后段圆弧半径 R2 (m)"); ax.set_ylabel("调头曲线长度 L (m)")
ax.set_ylim(L_base - 0.02, L_base + 0.02)
ax.set_title("曲线族长度不变性：L 与半径分配无关")
ax.legend(fontsize=9)
save_fig(fig, "fig_q4_Lcurve.png")

fig, (axa, axb) = plt.subplots(1, 2, figsize=(12.0, 6.4))
for t, c in ((-50, "#1f77b4"), (50, "#d62728")):
    axa.plot(X4[t + 100, :, 0], X4[t + 100, :, 1], ".", ms=2.2, color=c, label=f"t={t:+d} s")
circ = plt.Circle((0, 0), tg.R_DISK, fill=False, color="0.65", ls=":", lw=1)
axa.add_patch(circ)
axa.plot(0, 0, "k+", ms=9)
axa.set_aspect("equal")
axa.set_xlabel("x (m)"); axa.set_ylabel("y (m)")
axa.set_title("调头前后全队位形")
axa.legend(fontsize=9)
axb.plot(X4[100, :, 0], X4[100, :, 1], ".-", ms=3.5, lw=0.7, color="#1f77b4",
         label="t=0 把手链")
mus = np.linspace(-30, 30, 2000)
pts = tp.point(mus)
axb.plot(pts[:, 0], pts[:, 1], color="0.85", lw=1.0, label="调头路径")
circ = plt.Circle((0, 0), tg.R_DISK, fill=False, color="#d62728", ls="--", lw=1.1)
axb.add_patch(circ)
axb.plot([tg.A[0]], [tg.A[1]], "k*", ms=10)
axb.annotate("A（t=0 龙头）", tg.A, textcoords="offset points", xytext=(6, 6), fontsize=9)
axb.set_xlim(-6, 6); axb.set_ylim(-6, 6)
axb.set_aspect("equal")
axb.set_xlabel("x (m)"); axb.set_ylabel("y (m)")
axb.set_title("t=0 局部：龙头位于调头曲线起点")
axb.legend(fontsize=9)
fig.tight_layout()
save_fig(fig, "fig_q4_configs.png")

print(f"\n[运行时间] 问题4 总耗时 {time.time()-t_start:.1f} s")

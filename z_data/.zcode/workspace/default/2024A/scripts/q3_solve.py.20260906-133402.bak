# -*- coding: utf-8 -*-
"""问题3：最小螺距 p，使龙头前把手能沿螺线盘入到调头空间边界（r=4.5 m）且全队无碰撞。
F(p) = 边界时刻位形的最小板凳间距（主判据）；对照判据=中心线距离-0.30。
产出：figures/fig_q3_*.png。"""
import numpy as np
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dragon_core import (Spiral, ReversedPath, walk_chain, chain_points,
                         chord_residual, min_bench_distance,
                         min_centerline_distance, S_arc, bench_rects)
from figures_common import save_fig, COLORS
import matplotlib.pyplot as plt

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
t_start = time.time()
R_DISK = 4.5


def F_rect(p, R_disk=R_DISK):
    """边界时刻位形的最小板凳间距（主判据）。"""
    sp = Spiral(p)
    rp = ReversedPath(sp)
    b = sp.b
    th_b = R_disk / b
    s_b = float(S_arc(th_b, b))
    mu = walk_chain(rp, np.array([-s_b]))
    X = chain_points(rp, mu)[0]
    d, pair, _ = min_bench_distance(X)
    return d, pair, X, s_b


def F_center(p, R_disk=R_DISK):
    sp = Spiral(p)
    rp = ReversedPath(sp)
    b = sp.b
    s_b = float(S_arc(R_disk / b, b))
    X = chain_points(rp, walk_chain(rp, np.array([-s_b])))[0]
    d, pair = min_centerline_distance(X)
    return d - 0.30, pair


# ---------- F(p) 粗扫 ----------
ps = np.arange(0.30, 0.5601, 0.01)
Fs = np.empty(len(ps))
for i, p in enumerate(ps):
    Fs[i], _, _, _ = F_rect(p)[0:1] + (None,) * 0 if False else (F_rect(p)[0],) + (None,) * 0
print("粗扫完成")

# 上一行写复杂了，重算（保持数字一致）
for i, p in enumerate(ps):
    Fs[i] = F_rect(p)[0]
for p, f in zip(ps, Fs):
    print(f"    F({p:.2f}) = {f:+.4f}")
pos = np.where(Fs > 0)[0]
assert len(pos) and pos[0] > 0, "区间内无变号"
hi_p = ps[pos[0]]
lo_p = ps[pos[0] - 1]

# ---------- 二分求根 ----------
for _ in range(80):
    mid = 0.5 * (lo_p + hi_p)
    if F_rect(mid)[0] > 0:
        hi_p = mid
    else:
        lo_p = mid
    if hi_p - lo_p < 1e-11:
        break
p_min = 0.5 * (lo_p + hi_p)
d_at, pair_at, X_at, s_b_at = F_rect(p_min)
print(f"\n[求解] 最小螺距 p_min = {p_min:.6f} m（区间宽 {hi_p-lo_p:.2e}）")
print(f"[求解] p_min 时边界位形最小间距 = {d_at:.3e} m，临界板凳对 = {pair_at}")
print(f"[检验] p_min 弦长残差 = {chord_residual(ReversedPath(Spiral(p_min)), walk_chain(ReversedPath(Spiral(p_min)), np.array([0.0])))*0 + chord_residual(ReversedPath(Spiral(p_min)), walk_chain(ReversedPath(Spiral(p_min)), np.array([-float(S_arc(R_DISK/(p_min/(2*np.pi))), p_min/(2*np.pi))])))):.2e}")

# ---------- 对照判据 ----------
lo_c, hi_c = 0.30, 0.56
for _ in range(80):
    mid = 0.5 * (lo_c + hi_c)
    if F_center(mid) > 0:
        hi_c = mid
    else:
        lo_c = mid
    if hi_c - lo_c < 1e-11:
        break
p_min_cl = 0.5 * (lo_c + hi_c)
print(f"[对照] 中心线判据 p_min = {p_min_cl:.6f} m（较主判据 {'小' if p_min_cl < p_min else '大'} "
      f"{abs(p_min - p_min_cl):.6f} m）")

# ---------- P5 验证：盘入全程裕度单调下降，临界在边界时刻 ----------
p_chk = p_min + 0.01
sp = Spiral(p_chk); rp = ReversedPath(sp)
b = sp.b
s_b = float(S_arc(R_DISK / b, b))
dts = np.arange(0.0, 81.0, 2.0)          # 头部距边界弧长（=时间，v=1）
Dv = np.empty(len(dts))
for i, dt in enumerate(dts):
    X = chain_points(rp, walk_chain(rp, np.array([-(s_b + dt)])))[0]
    Dv[i], _, _ = min_bench_distance(X)[0:1] + (None, None) if False else (min_bench_distance(X)[0],) + (None,) * 0
print(f"\n[P5] p = p_min+0.01 时，盘入过程（头部距边界 0..80 m）D 序列：")
print("    " + "  ".join(f"{dt:.0f}s:{d:.3f}" for dt, d in zip(dts, Dv)))
print(f"[P5] D 随盘入单调下降且最小值在边界时刻: {bool(np.all(np.diff(Dv) < 1e-12))}")

# ---------- G8 灵敏度：调头空间直径 ±10% ----------
print("\n[G8] 调头空间直径敏感性：")
rows = []
for dd in (8.1, 8.55, 9.0, 9.45, 9.9):
    a, b_ = 0.30, 0.60
    for _ in range(80):
        mid = 0.5 * (a + b_)
        if F_rect(mid, dd / 2)[0] > 0:
            b_ = mid
        else:
            a = mid
        if b_ - a < 1e-11:
            break
    rows.append((dd, 0.5 * (a + b_)))
    print(f"    直径 {dd:.2f} m → p_min = {0.5*(a+b_):.6f} m")

# ---------- 图 ----------
fig, (axa, axb) = plt.subplots(1, 2, figsize=(11.5, 4.3))
ps_f = np.linspace(0.30, 0.56, 60)
Fs_f = np.empty(len(ps_f))
for i, p in enumerate(ps_f):
    Fs_f[i] = F_rect(p)[0]
axa.plot(ps_f, Fs_f, "-", color="#1f77b4", lw=1.3)
axa.axhline(0, color="0.6", lw=0.7)
axa.plot([p_min], [0], "o", color="#d62728", ms=6, label=f"p_min = {p_min:.6f} m")
axa.set_xlabel("螺距 p (m)"); axa.set_ylabel("边界时刻最小板凳间距 D (m)")
axa.set_title("判据函数 F(p) 与最小螺距")
axa.legend(fontsize=9)
axb.plot(dts, Dv, ".-", color="#2ca02c", lw=1.0)
axb.set_xlabel("龙头距边界弧长 (m)（=盘入剩余时间, s）")
axb.set_ylabel("最小板凳间距 D (m)")
axb.set_title(f"P5 验证：p={p_chk:.4f} m 盘入过程裕度")
fig.tight_layout()
save_fig(fig, "fig_q3_Fp.png")

fig, ax = plt.subplots(figsize=(7.0, 7.0))
ax.plot(X_at[:, 0], X_at[:, 1], "-", color="#1f77b4", lw=0.9)
circ = plt.Circle((0, 0), R_DISK, fill=False, color="#d62728", lw=1.2, ls="--")
ax.add_patch(circ)
ax.plot(X_at[0, 0], X_at[0, 1], "o", color="#d62728", ms=5, label="龙头前把手（边界上）")
ax.plot(0, 0, "k+", ms=10)
ax.set_aspect("equal")
ax.set_xlabel("x (m)"); ax.set_ylabel("y (m)")
ax.set_title(f"p_min = {p_min:.6f} m 时龙头前把手恰达调头空间边界")
ax.legend(fontsize=9)
save_fig(fig, "fig_q3_config.png")

np.save(f"{ROOT}/output/q3_result.npy",
        np.array([p_min, p_min_cl] + [r[1] for r in rows]))
print(f"\n[运行时间] 问题3 总耗时 {time.time()-t_start:.1f} s")

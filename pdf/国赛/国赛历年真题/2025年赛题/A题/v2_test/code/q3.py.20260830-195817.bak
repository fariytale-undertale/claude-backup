# -*- coding: utf-8 -*-
"""问题3：FY1 投 3 枚弹对 M1 遮蔽时长最大化（并集口径）——最终版。

关键洞察（G3 全参数域探查结论）：
  固定 Q2 最优航向 (176.6°) 时非零区仅 td∈[0,1.75]，容不下间隔>=1s 的三弹；
  航向改至 ~200° 后出现三分离非零窗口，三弹错峰各自接近单弹最优、区间不重叠，
  联合并集 ≈ 逐弹和 ≈ 12 s（固定航向解的 2.6 倍）。贪心(固定航向)被证伪。

求解器：
  起点池 = (th,td,tau) 全域粗扫的贪心组合 + 单弹最优错开式起点（多起点纪律 5-8）
  NM 8 维（theta, v, 3x(td,tau)），间隔约束用二次罚（允许 NM 穿越不可行区），
  精修后体判据精确复算 + G2 异源网格互证 + G5 边界哨兵。
"""
import sys, os, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from scipy.optimize import minimize
from core import (burst_pos, T_HIT, CYL_PTS, shaded_intervals,
                  union_length, grid_union_length, V_UAV_MIN, V_UAV_MAX,
                  G, UAVS, missile_pos, DT_MIN, SINK, T_EFF)
import matplotlib.pyplot as plt
import figures as F
import pandas as pd

t_start_all = time.time()
t_hit = T_HIT['M1']
P0 = UAVS['FY1']

_q2 = pd.read_csv(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               '..', 'output', 'tables', 'q2_results.csv'))
_q2d = dict(zip(_q2['量'], _q2['值']))
theta2 = np.radians(float(_q2d['航向角 theta (deg)']))
v2 = float(_q2d['速度 v (m/s)'])
q2_dur = float(_q2d['体判据遮蔽时长 (s)'])
print(f"[继承Q2] th={np.degrees(theta2):.4f}° v={v2:.2f} 时长={q2_dur:.4f}s")


def intervals_for(theta, v, td, tau, grid_dt=0.005):
    if td < 0 or tau <= 0:
        return []
    B = burst_pos('FY1', td, tau, theta, v)
    if B[2] < 0:
        return []
    return shaded_intervals(B, td + tau, 'M1', CYL_PTS, t_hit, grid_dt=grid_dt)


def eval3(theta, v, params, grid_dt=0.005, penalty=True):
    """三弹并集时长 + 约束罚。params 任意顺序。返回 (时长, 逐弹时长列表)。"""
    ps = sorted([(td, tau) for td, tau in params])
    pen = 0.0
    for i in range(2):
        gap = ps[i + 1][0] - ps[i][0]
        if gap < DT_MIN:
            pen += (DT_MIN - gap) ** 2 * 50.0
    if v < V_UAV_MIN or v > V_UAV_MAX:
        pen += 50.0 * (max(V_UAV_MIN - v, v - V_UAV_MAX, 0)) ** 2
    each = [union_length(intervals_for(theta, v, td, tau, grid_dt)) for td, tau in ps]
    return union_length([iv for e in each for iv in e]) - pen, each


# ---------------- 阶段1: 全域粗扫 + 贪心组合起点 ----------------
t1 = time.time()
ths_deg = np.arange(160, 206, 4)
tds_g = np.arange(0, 8.5, 0.5)
taus_g = np.arange(1.0, 6.0, 0.5)
cands = []
for thd in ths_deg:
    th = np.radians(thd)
    for td in tds_g:
        for tau in taus_g:
            B = burst_pos('FY1', td, tau, th, 70.0)
            if B[2] < 0:
                continue
            d = union_length(shaded_intervals(B, td + tau, 'M1', CYL_PTS, t_hit, grid_dt=0.04))
            if d > 0.3:
                cands.append((d, thd, td, tau))
cands.sort(key=lambda x: -x[0])
print(f"[阶段1] 全域粗扫候选 {len(cands)} 个（体判据 dt=0.04），耗时 {time.time()-t1:.1f}s")

pool = cands[:50]
combos = []
def combo_rec(chosen, idx):
    if len(chosen) == 3:
        combos.append(list(chosen))
        return
    for j in range(idx, len(pool)):
        if all(abs(pool[j][2] - c[2]) >= DT_MIN for c in chosen):
            chosen.append(pool[j])
            combo_rec(chosen, j + 1)
            chosen.pop()
        if len(chosen) + (len(pool) - j) < 3:
            break
combo_rec([], 0)
combos.sort(key=lambda c: -sum(x[0] for x in c))
print(f"[阶段1] 三弹错峰组合 {len(combos)} 个，组合上界 top = "
      f"{sum(x[0] for x in combos[0]):.3f}s "
      f"({[(round(c[0],2), c[1], c[2]) for c in combos[0]]})")

# ---------------- 阶段2: NM 8 维联合精修（起点数纪律: 6 个） ----------------
def neg8(x):
    th = x[0] % (2 * np.pi)
    d, _ = eval3(th, x[1], [(x[2 + 2 * i], x[3 + 2 * i]) for i in range(3)],
                 grid_dt=0.02)
    return -d if d > 0 else 10.0 + abs(d)

starts = []
for c in combos[:3]:     # 组合 top-3
    th_mean = np.radians(np.mean([x[1] for x in c]))
    starts.append(np.array([th_mean, 70.0] + [xx for e in c for xx in (e[2], e[3])]))
starts.append(np.array([theta2, v2, 0.0, 2.5, 1.0, 2.8, 2.0, 3.2]))   # Q2 错开式
starts.append(np.array([np.radians(200.5), 70.0, 0.0, 2.5, 1.0, 2.8, 2.1, 3.5]))
starts.append(np.array([np.radians(196.0), 74.0, 0.2, 2.6, 1.3, 3.0, 2.5, 3.6]))

t2 = time.time()
best = None
nm_trajs = []
for i, x0 in enumerate(starts):
    x0 = np.clip(x0, [0, 70, 0, 0.2, 0, 0.2, 0, 0.2], [2 * np.pi, 140, 20, 12, 20, 12, 20, 12])
    traj = [-neg8(x0)]
    res = minimize(neg8, x0, method='Nelder-Mead',
                   options={'maxfev': 2500, 'xatol': 1e-6, 'fatol': 1e-9},
                   callback=lambda xk: traj.append(-neg8(xk)))
    th_r = res.x[0] % (2 * np.pi)
    d_exact, each = eval3(th_r, res.x[1],
                          [(res.x[2 + 2 * j], res.x[3 + 2 * j]) for j in range(3)],
                          grid_dt=0.005)
    nm_trajs.append(traj)
    print(f"[NM{i}] 粗 {max(traj):.4f} -> 精确 {d_exact:.4f}s 各弹 "
          f"{[round(e,3) for e in each]} @ th={np.degrees(th_r):.2f} v={res.x[1]:.2f} "
          f"td={[round(res.x[2+2*j],3) for j in range(3)]}")
    if best is None or d_exact > best[0]:
        best = (d_exact, res.x.copy(), each)
print(f"[阶段2] NM 精修耗时 {time.time()-t2:.1f}s，最优 {best[0]:.4f}s")

# ---------------- 阶段3: 精确复算 + G2 互证 + 哨兵 ----------------
xb = best[1]
theta_f = xb[0] % (2 * np.pi)
v_f = xb[1]
params_f = sorted([(xb[2 + 2 * i], xb[3 + 2 * i]) for i in range(3)])
ivs_per = [intervals_for(theta_f, v_f, td, tau, grid_dt=0.002) for td, tau in params_f]
dur_final = union_length([iv for e in ivs_per for iv in e])
per_durs = [union_length(e) for e in ivs_per]

bursts = [(burst_pos('FY1', td, tau, theta_f, v_f), td + tau) for td, tau in params_f]
dur_grid_check, mask_grid = grid_union_length(bursts, 'M1', CYL_PTS, t_hit, dt=0.0005)

print(f"\n[最终解] theta={np.degrees(theta_f)%360:.4f}° v={v_f:.4f}")
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0.0])
    print(f"  弹{i+1}: t_d={td:.4f} tau={tau:.4f} t_b={td+tau:.4f} "
          f"D=({D[0]:.2f},{D[1]:.2f},1800) B=({B[0]:.2f},{B[1]:.2f},{B[2]:.2f}) "
          f"单独时长={per_durs[i]:.4f}")
print(f"[最终解] 并集遮蔽时长 = {dur_final:.4f}s (逐弹和 {sum(per_durs):.4f}s, "
      f"重叠 {sum(per_durs)-dur_final:.4f}s)")
print(f"[G2互证] 细网格 dt=5e-4 = {dur_grid_check:.4f}s  |差| = {abs(dur_final-dur_grid_check):.2e}")
assert abs(dur_final - dur_grid_check) < 8e-4

# G5 边界哨兵
flags = []
if abs(v_f - V_UAV_MIN) < 0.5 or abs(v_f - V_UAV_MAX) < 0.5:
    flags.append(f'v={v_f:.2f} 卡边界')
gaps = [params_f[i+1][0] - params_f[i][0] for i in range(2)]
for i, g in enumerate(gaps):
    if abs(g - DT_MIN) < 0.05:
        flags.append(f'弹{i+1}-{i+2}间隔卡1s下界(gap={g:.3f})')
print(f"[G5] {'; '.join(flags) if flags else '无卡边界'}; 间隔 = {[round(g,3) for g in gaps]}")

# P5 触地监控
for i, (b, tb_i) in enumerate(bursts):
    zend = b[2] - SINK * (min(tb_i + T_EFF, t_hit) - tb_i)
    if zend <= 0:
        print(f"[P5警告] 弹{i+1} 云团触地 z={zend:.1f}")
print(f"[P5] 云团最低 z = {min(b[2] - SINK*(min(tb+T_EFF,t_hit)-tb) for b, tb in bursts):.1f} m")

# ---------------- 图表 ----------------
F.gantt(ivs_per, [f'弹{i+1}' for i in range(3)], [[td] for td, _ in params_f],
        '问题3: 三弹遮蔽区间甘特图（并集总时长 %.3f s）' % dur_final, 'q3_gantt.png')

fig3, (ax_z, ax_g) = plt.subplots(2, 1, figsize=(14, 13))
tm = np.linspace(0, t_hit, 800)
Mm = missile_pos('M1', tm)
zx0 = min(P0[0], min(b[0] for b, _ in bursts)) - 300
zx1 = max(P0[0] + v_f * (params_f[-1][0] + 2) * np.cos(theta_f),
          max(b[0] for b, _ in bursts)) + 300

inw = (Mm[:, 0] > zx0) & (Mm[:, 0] < zx1)
ax_z.plot(Mm[inw, 0], Mm[inw, 2], color=F.C_RED, lw=1.8, alpha=0.6, label='M1 弹道')
for k, (a, b) in enumerate(sorted(iv for e in ivs_per for iv in e)):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_z.plot(Ms[:, 0], Ms[:, 2], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
t_line = params_f[-1][0] + 2
ax_z.plot([P0[0], P0[0] + v_f * t_line * np.cos(theta_f)], [1800, 1800],
          color=F.C_BLU, lw=2.5, label='FY1 航线')
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0.0])
    tp = np.linspace(0, tau, 30)
    ax_z.plot(D[0] + v_f * tp * np.cos(theta_f), 1800 - 0.5 * G * tp ** 2,
              color=F.SERIES[i], lw=1.8, alpha=0.9)
    ax_z.scatter([D[0]], [D[2]], marker='^', s=90, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_z.scatter([B[0]], [B[2]], marker='*', s=240, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_z.annotate(f'弹{i+1} t_b={td+tau:.1f}s', (B[0], B[2]), textcoords='offset points',
                  xytext=(6, 8), fontsize=8, color=F.SERIES[i])
for b, tb_i in bursts:
    tc = np.linspace(tb_i, min(tb_i + T_EFF, t_hit), 30)
    Cc = b + np.array([0, 0, -SINK]) * (tc - tb_i)[:, None]
    ax_z.plot(Cc[:, 0], Cc[:, 2], color=F.C_CLOUD, lw=1.2, alpha=0.8)
ax_z.set_xlabel('x (m)')
ax_z.set_ylabel('z (m)')
ax_z.set_title('问题3: 三弹投放-起爆 xz 侧视图', fontweight='bold')
ax_z.grid(True, ls='--', alpha=0.3)
ax_z.set_aspect('equal')
ax_z.legend(loc='lower left', fontsize=8)
ax_z.set_xlim(zx0, zx1)

ax_g.plot(Mm[:, 0], Mm[:, 1], color=F.C_RED, lw=1.2, alpha=0.55, label='M1 弹道')
for k, (a, b) in enumerate(sorted(iv for e in ivs_per for iv in e)):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_g.plot(Ms[:, 0], Ms[:, 1], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
ax_g.plot([P0[0], P0[0] + v_f * t_line * np.cos(theta_f)],
          [P0[1], P0[1] + v_f * t_line * np.sin(theta_f)], color=F.C_BLU, lw=2,
          alpha=0.85, label='FY1 航线')
F.draw_targets(ax_g)
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0.0])
    ax_g.scatter([D[0]], [D[1]], marker='^', s=70, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_g.scatter([B[0]], [B[1]], marker='*', s=190, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_g.annotate(f'弹{i+1}', (B[0], B[1]), textcoords='offset points', xytext=(6, 6),
                  fontsize=8, color=F.SERIES[i])
ax_g.scatter([], [], marker='^', s=60, c='black', label='投放点(=弹色)')
ax_g.scatter([], [], marker='*', s=160, c='black', label='起爆点(=弹色)')
ax_g.annotate(f'真目标(0,200)  v={v_f:.1f}m/s', xy=(0.03, 0.05), xycoords='axes fraction',
              fontsize=8, bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkgreen'))
F.setup_map_axes(ax_g, '问题3: 全局态势 (xy)')
ax_g.legend(loc='center right', fontsize=9)
F.save(fig3, 'q3_trajectory.png')

# 收敛图
fig4, ax4 = plt.subplots(figsize=(9, 5))
fig4.suptitle('问题3: 联合 NM 收敛曲线（6 起点）', fontsize=13, fontweight='bold')
for i, tr in enumerate(nm_trajs):
    ax4.plot(np.arange(len(tr)), np.maximum(tr, 0), lw=1.6, alpha=0.85,
             color=F.SERIES[i % 5], label=f'起点{i+1}')
ax4.scatter([0], [dur_final], c='red', marker='*', s=180, zorder=6,
            label=f'最优 {dur_final:.4f}s')
ax4.set_xlabel('NM 迭代')
ax4.set_ylabel('三弹并集时长 (s)')
ax4.grid(True, ls='--', alpha=0.3)
ax4.legend(fontsize=8)
F.save(fig4, 'q3_convergence.png')

# ---------------- result1.xlsx + 结果表 ----------------
out_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output')
tab_dir = os.path.join(out_dir, 'tables')
rows = []
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0.0])
    rows.append([np.degrees(theta_f) % 360, v_f, i + 1,
                 D[0], D[1], D[2], B[0], B[1], B[2], per_durs[i]])
res = pd.DataFrame(rows, columns=['无人机运动方向', '无人机运动速度 (m/s)', '烟幕干扰弹编号',
                                  '烟幕干扰弹投放点的x坐标 (m)', '烟幕干扰弹投放点的y坐标 (m)',
                                  '烟幕干扰弹投放点的z坐标 (m)', '烟幕干扰弹起爆点的x坐标 (m)',
                                  '烟幕干扰弹起爆点的y坐标 (m)', '烟幕干扰弹起爆点的z坐标 (m)',
                                  '有效干扰时长 (s)'])
res.to_excel(os.path.join(out_dir, 'result1.xlsx'), index=False)
print("  [表] result1.xlsx")

pd.DataFrame([
    ['航向角 theta (deg)', f'{np.degrees(theta_f)%360:.4f}'],
    ['速度 v (m/s)', f'{v_f:.4f}'],
    ['弹1 (t_d, tau)', f'({params_f[0][0]:.4f}, {params_f[0][1]:.4f})'],
    ['弹2 (t_d, tau)', f'({params_f[1][0]:.4f}, {params_f[1][1]:.4f})'],
    ['弹3 (t_d, tau)', f'({params_f[2][0]:.4f}, {params_f[2][1]:.4f})'],
    ['并集遮蔽时长 (s)', f'{dur_final:.4f}'],
    ['逐弹时长 (s)', f'{[round(d,4) for d in per_durs]}'],
    ['G2网格互证 (s)', f'{dur_grid_check:.4f}'],
], columns=['量', '值']).to_csv(os.path.join(tab_dir, 'q3_results.csv'), index=False,
                               encoding='utf-8-sig')
print(f"\n总运行时间: {time.time()-t_start_all:.1f} s")

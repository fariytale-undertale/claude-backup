# -*- coding: utf-8 -*-
"""问题1：FY1 定策略（120 m/s 朝假目标，t_d=1.5 s，τ=3.6 s）对 M1 的有效遮蔽时长。

模型唯一（题面给定全部决策），无模型选择闸门。输出：双判据时长 + 判据函数曲线图 + 场景图。
"""
import sys, os, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import matplotlib.pyplot as plt
from core import (burst_pos, drop_pos, T_HIT, CYL_PTS, CENTER_PT, R_CLOUD,
                  traj_cloud, missile_pos, dist2_time_grid, R2,
                  shaded_intervals, shaded_intervals_point, union_length,
                  grid_union_length, T_EFF, SINK)
import figures as F

t_start = time.time()

# ---- 输入（题面给定）----
v, t_d, tau = 120.0, 1.5, 3.6
theta = np.pi                       # FY1(17800,0,1800) 朝假目标(原点)：-x 方向 = pi rad
t_b = t_d + tau
t_hit = T_HIT['M1']

# ---- 中间量（G4：脚本 print，不心算）----
D = drop_pos('FY1', t_d, theta, v)
B = burst_pos('FY1', t_d, tau, theta, v)
print(f"航向角 theta = {np.degrees(theta):.1f} deg (0~360, x正向逆时针)")
print(f"投放点 D = ({D[0]:.3f}, {D[1]:.3f}, {D[2]:.3f}) m   t_d = {t_d} s")
print(f"起爆点 B = ({B[0]:.3f}, {B[1]:.3f}, {B[2]:.3f}) m   t_b = {t_b} s")

# ---- 双判据遮蔽区间 ----
ivs_body = shaded_intervals(B, t_b, 'M1', CYL_PTS, t_hit)
ivs_pt = shaded_intervals_point(B, t_b, 'M1', t_hit)
dur_body = union_length(ivs_body)
dur_pt = union_length(ivs_pt)

# G2 异源互证（独立细网格）
dur_grid, mask_grid = grid_union_length([(B, t_b)], 'M1', CYL_PTS, t_hit, dt=0.0005)

print(f"\n[体判据(正式)] 遮蔽区间 = {[(round(a,6), round(b,6)) for a,b in ivs_body]}")
print(f"[体判据(正式)] 有效遮蔽时长 = {dur_body:.6f} s")
print(f"[点判据(对比)] 遮蔽区间 = {[(round(a,6), round(b,6)) for a,b in ivs_pt]}")
print(f"[点判据(对比)] 有效遮蔽时长 = {dur_pt:.6f} s")
print(f"[互证] 细网格(dt=5e-4) 时长 = {dur_grid:.6f} s  |解析-网格| = {abs(dur_body-dur_grid):.2e} s")
print(f"[对比] 点判据 - 体判据 = {dur_pt - dur_body:+.6f} s  (点判据高估 {100*(dur_pt/dur_body-1):.2f}%)")

# 触地监控（P5）
t_end = min(t_b + T_EFF, t_hit)
zmin = B[2] - SINK * (t_end - t_b)
print(f"[P5监控] 云团最低点 z = {zmin:.1f} m (>0, 未触地)")

assert abs(dur_body - dur_grid) < 6e-4, "解析与网格互证不一致"

# ---- 图1：判据函数 f(t) 曲线（建模性+结果性合一：显示进入/离开遮蔽的根）----
ts = np.linspace(t_b, min(t_b + T_EFF, t_hit), 3000)
C = traj_cloud(B, t_b, ts)
M = missile_pos('M1', ts)
f_body = dist2_time_grid(C, M, CYL_PTS).max(axis=1) - R2
f_pt = dist2_time_grid(C, M, CENTER_PT[None, :])[:, 0] - R2

fig, ax = plt.subplots(figsize=(10, 5.5))
fig.suptitle('问题1: 遮蔽判据函数 f(t) = max_k dist^2(C(t), 视线_k) - R^2', fontsize=13, fontweight='bold')
ax.plot(ts, f_body, color=F.C_BLU, lw=2, label=f'体判据 (72点全遮蔽)  时长={dur_body:.4f}s')
ax.plot(ts, f_pt, color=F.C_ORG, lw=1.6, ls='--', label=f'点判据 (柱心)  时长={dur_pt:.4f}s')
ax.axhline(0, color='black', lw=1)
for (a, b) in ivs_body:
    ax.axvspan(a, b, color=F.C_BLU, alpha=0.15)
    ax.annotate(f'{a:.3f}', (a, 0), textcoords='offset points', xytext=(-6, 10),
                fontsize=8, ha='right', color=F.C_BLU)
    ax.annotate(f'{b:.3f}', (b, 0), textcoords='offset points', xytext=(6, 10),
                fontsize=8, ha='left', color=F.C_BLU)
ax.set_xlabel('时间 t (s)')
ax.set_ylabel('f(t) (m^2)')
ax.set_title('f(t) <= 0 即有效遮蔽；阴影区为体判据遮蔽区间（纵轴聚焦，t>10.2s 后 f 单调增至 3e7 已越出）', fontsize=10)
ax.set_ylim(-150, 1500)
ax.legend(fontsize=9, loc='upper left')
ax.grid(True, ls='--', alpha=0.3)
# inset：遮蔽区间两端放大，展示两判据根的差异（跨抽象层证据）
axi = ax.inset_axes([0.55, 0.42, 0.42, 0.42])
m_in = (ts > 7.8) & (ts < 9.7)
axi.plot(ts[m_in], f_body[m_in], color=F.C_BLU, lw=1.8)
axi.plot(ts[m_in], f_pt[m_in], color=F.C_ORG, lw=1.4, ls='--')
axi.axhline(0, color='black', lw=0.8)
axi.axvspan(ivs_body[0][0], ivs_body[0][1], color=F.C_BLU, alpha=0.12)
axi.set_xlim(7.8, 9.7)
axi.set_ylim(-40, 40)
axi.set_title('遮蔽区间局部放大', fontsize=9)
axi.tick_params(labelsize=8)
axi.grid(True, ls='--', alpha=0.3)
ax.indicate_inset_zoom(axi, edgecolor='gray')
F.save(fig, 'q1_f_curve.png')

# ---- 图2：场景俯视图（双面板：全局 + 局部放大）----
fig = plt.figure(figsize=(16, 8.5))
ax_g = fig.add_axes([0.60, 0.10, 0.37, 0.76])
ax_z = fig.add_axes([0.05, 0.10, 0.52, 0.76])

tm = np.linspace(0, t_hit, 600)
Mm = missile_pos('M1', tm)

# --- 全局面板 ---
ax_g.plot(Mm[:, 0], Mm[:, 1], color=F.C_RED, lw=1.2, alpha=0.55, label='M1 弹道')
for k, (a, b) in enumerate(ivs_body):
    tseg = np.linspace(a, b, 50)
    Ms = missile_pos('M1', tseg)
    ax_g.plot(Ms[:, 0], Ms[:, 1], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
ax_g.plot([17800, D[0], B[0]], [0, 0, 0], color=F.C_BLU, lw=2, alpha=0.85, label='FY1 航线')
F.draw_targets(ax_g)
ax_g.scatter([D[0]], [D[1]], marker='^', s=70, c=F.C_RED, edgecolor='darkred', zorder=6, label='投放点')
ax_g.scatter([B[0]], [B[1]], marker='*', s=200, c=F.C_BLU, edgecolor='black', zorder=6, label='起爆点')
# 放大区域框
rect = plt.Rectangle((16800, -400), 1400, 800, facecolor='yellow', alpha=0.12,
                     edgecolor='orange', ls='--', lw=1.5)
ax_g.add_patch(rect)
ax_g.annotate('放大区域', (17500, 420), fontsize=8, ha='center', color='darkorange')
ax_g.annotate('真目标 (0,200)', xy=(0.04, 0.05), xycoords='axes fraction', fontsize=8,
              bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkgreen'))
F.setup_map_axes(ax_g, '问题1: 全局态势俯视图')
ax_g.legend(loc='upper left', fontsize=8, framealpha=0.9)

# --- 局部放大面板（投放-起爆区域 + 遮蔽几何）---
zx0, zx1, zy0, zy1 = 16800, 18200, -500, 500
tmz = tm[(Mm[:, 0] > zx0 - 100) & (Mm[:, 0] < zx1 + 100)]
ax_z.plot(tmz * 0 + Mm[np.isin(tm, tmz), 0], Mm[np.isin(tm, tmz), 1], color=F.C_RED,
          lw=2, alpha=0.6, label='M1 弹道')
ax_z.plot([17800, D[0], B[0]], [0, 0, 0], color=F.C_BLU, lw=2.5, alpha=0.85, label='FY1 航线')
ax_z.scatter([17800], [0], marker='s', s=130, c=F.C_BLU, edgecolor='darkblue', zorder=6, label='FY1 起点')
ax_z.scatter([D[0]], [D[1]], marker='^', s=130, c=F.C_RED, edgecolor='darkred', zorder=7)
ax_z.annotate(f'投放 t={t_d}s', (D[0], D[1]), textcoords='offset points',
              xytext=(-4, 14), fontsize=9, ha='right', color='darkred')
ax_z.scatter([B[0]], [B[1]], marker='*', s=320, c=F.C_BLU, edgecolor='black', zorder=7)
ax_z.annotate(f'起爆 t={t_b:.1f}s', (B[0], B[1]), textcoords='offset points',
              xytext=(-6, 16), fontsize=9, ha='right', color='darkblue')
circ = plt.Circle((B[0], B[1]), R_CLOUD, facecolor=F.C_CLOUD, alpha=0.30,
                  edgecolor=F.C_CLOUD, lw=1.5, zorder=5)
ax_z.add_patch(circ)
ax_z.annotate('云团 r=10m', (B[0] + 9, B[1] + 9), textcoords='offset points',
              xytext=(8, 8), fontsize=8, color='#21618C')
# 起爆时刻 M1 位置 + 遮蔽判定视线
Mtb = missile_pos('M1', t_b)
ax_z.scatter([Mtb[0]], [Mtb[1]], marker='o', s=90, c='darkred', edgecolor='black', zorder=7)
ax_z.annotate(f'M1 t={t_b:.1f}s', (Mtb[0], Mtb[1]), textcoords='offset points',
              xytext=(10, 8), fontsize=9, color='darkred')
# 遮蔽区间端点时刻的 M1 位置与视线（导弹->云团->真目标方向）
for lbl, tq in [('遮蔽开始', ivs_body[0][0]), ('遮蔽结束', ivs_body[0][1])]:
    Mq = missile_pos('M1', tq)
    Cq = traj_cloud(B, t_b, np.array([tq]))[0]
    ax_z.plot([Mq[0], 0], [Mq[1], 200], color=F.C_ORG, lw=1, ls=':', alpha=0.8)
    ax_z.scatter([Mq[0]], [Mq[1]], marker='o', s=45, c=F.C_ORG, edgecolor='black', zorder=7)
    ax_z.annotate(lbl, (Mq[0], Mq[1]), textcoords='offset points', xytext=(10, -14),
                  fontsize=8, color='darkorange')
ax_z.annotate('视线(点线)穿过云团 -> 真目标(0,200) 方向', xy=(0.02, 0.03),
              xycoords='axes fraction', fontsize=8,
              bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkorange'))
ax_z.annotate('真目标 ->', xy=(0.99, 0.03), xycoords='axes fraction', fontsize=8,
              ha='right', color='darkgreen')
F.setup_map_axes(ax_z, '问题1: 投放-起爆局部放大图')
ax_z.legend(loc='upper left', fontsize=8, framealpha=0.9)
ax_z.set_xlim(zx0, zx1)
ax_z.set_ylim(zy0, zy1)
F.save(fig, 'q1_trajectory.png')

# ---- 结果表 ----
import pandas as pd
tab_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output', 'tables')
os.makedirs(tab_dir, exist_ok=True)
df = pd.DataFrame([
    ['航向角 theta (deg)', '120 m/s 朝假目标方向', f'{np.degrees(theta):.1f}'],
    ['投放时刻 t_d (s)', '题面给定', f'{t_d}'],
    ['引信延迟 tau (s)', '题面给定', f'{tau}'],
    ['投放点 D (m)', '脚本计算', f'({D[0]:.3f}, {D[1]:.3f}, {D[2]:.3f})'],
    ['起爆点 B (m)', '脚本计算', f'({B[0]:.3f}, {B[1]:.3f}, {B[2]:.3f})'],
    ['起爆时刻 t_b (s)', 't_d + tau', f'{t_b}'],
    ['体判据遮蔽区间 (s)', '72点全遮蔽', f'[{ivs_body[0][0]:.6f}, {ivs_body[0][1]:.6f}]'],
    ['体判据有效遮蔽时长 (s)', '正式口径', f'{dur_body:.4f}'],
    ['点判据有效遮蔽时长 (s)', '对比口径', f'{dur_pt:.4f}'],
    ['互证网格时长 (s)', 'dt=5e-4', f'{dur_grid:.4f}'],
], columns=['量', '来源', '值'])
df.to_csv(os.path.join(tab_dir, 'q1_results.csv'), index=False, encoding='utf-8-sig')
print(f"  [表] {os.path.join(tab_dir, 'q1_results.csv')}")

print(f"\n运行时间: {time.time()-t_start:.1f} s")

# -*- coding: utf-8 -*-
"""问题2：FY1 单弹对 M1 遮蔽时长最大化（最终版）。

求解器链（G-Cost 闸门：形态诊断非零占比 0% -> 稀疏针尖形 -> 结构驱动）：
  阶段1 结构热启动：结构参数化 (t_b, s)（A2+A3 消元：起爆点水平位置必在无人机航线上），
        粗网格点判据排序 -> top-8 初值。
  阶段2 4D NM 精化（短预算）：发现 t_d/v 滑向边界 -> G5 哨兵触发。
  阶段3 G5 追查 + 单调性证明：v profile 全域单调（越慢越长）、t_d profile 单调（越早越长）
        => 固定 v=70, t_d=0（降维），对 (theta, tau) 2D 稠密粗扫 + 6 起点 NM 精修。
  阶段4 最终确认：精确区间求根 + G2 异源网格互证 + 点判据跨抽象层对比。
"""
import sys, os, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from scipy.optimize import minimize
from core import (burst_pos, T_HIT, CYL_PTS, CENTER_PT, shaded_intervals,
                  shaded_intervals_point, union_length, grid_union_length,
                  V_UAV_MIN, V_UAV_MAX, G, UAVS, missile_pos, SINK, T_EFF)
import matplotlib.pyplot as plt
import figures as F
import pandas as pd

t_start_all = time.time()
t_hit = T_HIT['M1']
P0 = UAVS['FY1']
PT = CENTER_PT


def strategy_from_struct(t_b, s):
    """(t_b, s) -> (theta, v, t_d, tau) 或 None。结构参数化（论文 5.3 节）。"""
    M = missile_pos('M1', float(t_b))
    B = M + s * (PT - M)
    if B[2] >= 1800.0 or B[2] <= 0:
        return None
    tau = np.sqrt(2.0 * (1800.0 - B[2]) / G)
    t_d = t_b - tau
    if t_d < 0.0:
        return None
    dh = B[:2] - P0[:2]
    v = np.linalg.norm(dh) / t_b
    if v < V_UAV_MIN - 1e-9 or v > V_UAV_MAX + 1e-9:
        return None
    theta = np.arctan2(dh[1], dh[0]) % (2 * np.pi)
    return theta, v, t_d, tau


def duration(theta, v, t_d, tau, body=True, grid_dt=0.005):
    if tau <= 0 or t_d < 0:
        return -1.0
    B = burst_pos('FY1', t_d, tau, theta, v)
    if B[2] < 0:
        return -1.0
    if body:
        ivs = shaded_intervals(B, t_d + tau, 'M1', CYL_PTS, t_hit, grid_dt=grid_dt)
    else:
        ivs = shaded_intervals_point(B, t_d + tau, 'M1', t_hit, grid_dt=grid_dt)
    return union_length(ivs)


# ---------------- 阶段1: 结构热启动 ----------------
t1 = time.time()
tb_grid = np.linspace(1.0, 25.0, 49)
s_grid = np.linspace(0.01, 0.60, 30)
cands = []
for tb in tb_grid:
    for s in s_grid:
        st = strategy_from_struct(tb, s)
        if st is None:
            continue
        d_pt = duration(*st, body=False, grid_dt=0.02)
        if d_pt > 0:
            cands.append((d_pt, tb, s, st))
cands.sort(key=lambda x: -x[0])
print(f"[阶段1] 结构粗网格 {len(tb_grid)}x{s_grid.size}，可行 {len(cands)}，"
      f"点判据 top = {cands[0][0]:.3f}s，耗时 {time.time()-t1:.1f}s")

# ---------------- 阶段2: 4D NM 短预算精化 + G5 哨兵 ----------------
t2 = time.time()
def neg4(x):
    th, v, td, tau = x
    if not (V_UAV_MIN - 1e-6 <= v <= V_UAV_MAX + 1e-6) or td < 0 or tau <= 0:
        return 10.0
    d = duration(th % (2 * np.pi), v, td, tau, body=True, grid_dt=0.005)
    return -d if d > 0 else 10.0 + abs(d)

nm_traj = []          # 收敛轨迹（画图用）
best4 = None
for d_pt, tb0, s0, st0 in cands[:4]:          # 4 起点（短预算）
    traj = []

    def cb(xk):
        traj.append(-neg4(xk))
    res = minimize(neg4, np.array(st0), method='Nelder-Mead',
                   options={'maxfev': 150, 'xatol': 1e-6, 'fatol': 1e-9}, callback=cb)
    nm_traj.append(traj)
    val = -res.fun if res.fun < 10 else 0.0
    if best4 is None or val > best4[0]:
        best4 = (val, res.x.copy(), traj)
dur4 = best4[0]
th4, v4, td4, tau4 = (best4[1][0] % (2 * np.pi), best4[1][1], best4[1][2], best4[1][3])
print(f"[阶段2] 4D NM 最优 {dur4:.4f}s @ th={np.degrees(th4):.2f} v={v4:.2f} "
      f"td={td4:.4f} tau={tau4:.3f}，耗时 {time.time()-t2:.1f}s")

# G5 边界哨兵
flags = []
if min(abs(v4 - V_UAV_MIN), abs(v4 - V_UAV_MAX)) < 1.0:
    flags.append(f'v={v4:.1f} 近边界')
if td4 < 0.2:
    flags.append(f't_d={td4:.4f} 卡下界')
print(f"[G5哨兵] {'; '.join(flags) if flags else '无卡边界'}")

# ---------------- 阶段3: 单调性 profile + 降维 2D 精修（无条件执行） ----------------
# 说明：短预算 4D NM 不保证滑到边界，单调性 profile 必须无条件做，
# 否则 G5 哨兵依赖 NM 恰好滑向边界这一偶然行为（本轮已实际发生漏判）。
t3 = time.time()
if True:
    # v profile（固定其余为 4D 解）
    v_scan = np.array([70., 75, 80, 85, 90, 100, 110, 120, 130, 140.])
    prof_v = [duration(th4, vv, max(td4, 0.0), tau4, body=True, grid_dt=0.01) for vv in v_scan]
    mono_v = all(prof_v[i] >= prof_v[i + 1] - 1e-3 for i in range(len(prof_v) - 1))
    # t_d profile
    td_scan = np.array([0., 0.2, 0.5, 0.8, 1.2, 1.6, 2.0])
    prof_td = [duration(th4, v4, tt, tau4, body=True, grid_dt=0.01) for tt in td_scan]
    mono_td = all(prof_td[i] >= prof_td[i + 1] - 1e-3 for i in range(len(prof_td) - 1))
    print(f"[单调性] v profile 单调递减(v↓时长↑): {mono_v}; t_d profile 单调递减: {mono_td}")
    assert mono_v and mono_td, "单调性不成立，不能降维"
    print("[降维] 固定 v=70, t_d=0，(theta, tau) 2D 精修")

    def dur2(th, tau, gdt):
        B = burst_pos('FY1', 0.0, tau, th, 70.0)
        if B[2] < 0:
            return -1.0
        return union_length(shaded_intervals(B, tau, 'M1', CYL_PTS, t_hit, grid_dt=gdt))

    # 2D 粗扫（窗口取 4D 解邻域扩 15°/1.5s，grid_dt=0.05）
    ths2 = np.radians(np.linspace(max(150, np.degrees(th4) - 15),
                                  min(210, np.degrees(th4) + 15), 61))
    taus2 = np.linspace(1.0, tau4 + 1.5, 51)
    best2 = (0.0, None)
    for th in ths2:
        for tau in taus2:
            d = dur2(th, tau, 0.05)
            if d > best2[0]:
                best2 = (d, (th, tau))
    print(f"[阶段3] 2D 粗扫 {len(ths2)}x{len(taus2)}，粗最优 {best2[0]:.4f}s，"
          f"累计 {time.time()-t3:.1f}s")

    def neg2(y):
        th, tau = y
        if tau <= 0.05:
            return 10.0
        d = dur2(th % (2 * np.pi), tau, 0.005)
        return -d if d > 0 else 10.0 + abs(d)

    wins = []
    traj2_all = []
    rng = np.random.default_rng(3)
    for k in range(6):
        y0 = (np.array(best2[1]) if k == 0 else
              np.array([best2[1][0] + rng.normal(0, 0.02), best2[1][1] + rng.normal(0, 0.2)]))
        tr = [ -neg2(y0) ]
        res = minimize(neg2, y0, method='Nelder-Mead',
                       options={'maxfev': 500, 'xatol': 1e-7, 'fatol': 1e-10},
                       callback=lambda yk: tr.append(-neg2(yk)))
        wins.append((-res.fun, res.x.copy()))
        traj2_all.append(tr)
    wins.sort(key=lambda w: -w[0])
    dur_star, (th_star, tau_star) = wins[0]
    print(f"[阶段3] 6 起点 NM 全部收敛至 {wins[0][0]:.6f}s "
          f"({'一致' if max(w[0] for w in wins)-min(w[0] for w in wins) < 1e-4 else '分散!'})")
    theta_b, v_b, td_b, tau_b = th_star % (2 * np.pi), 70.0, 0.0, tau_star
    dur_final = dur_star
else:
    theta_b, v_b, td_b, tau_b = th4, v4, td4, tau4
    dur_final = dur4

# 邻域确认
nb_best = 0.0
for dth in np.linspace(-0.02, 0.02, 5):
    for dtau in np.linspace(-0.05, 0.05, 5):
        nb_best = max(nb_best, duration(theta_b + dth, v_b, td_b, tau_b + dtau,
                                        grid_dt=0.005))
print(f"[邻域确认] 邻域最高 {nb_best:.6f} vs 解 {dur_final:.6f} "
      f"({'OK' if nb_best <= dur_final + 1e-4 else '警告'})")

# ---------------- 阶段4: 最终确认 + G2 互证 + 跨抽象层 ----------------
B_b = burst_pos('FY1', td_b, tau_b, theta_b, v_b)
tb_b = td_b + tau_b
ivs_final = shaded_intervals(B_b, tb_b, 'M1', CYL_PTS, t_hit, grid_dt=0.002)
dur_check = union_length(ivs_final)
dur_grid_check, _ = grid_union_length([(B_b, tb_b)], 'M1', CYL_PTS, t_hit, dt=0.0005)
ivs_pt_final = shaded_intervals_point(B_b, tb_b, 'M1', t_hit, grid_dt=0.002)
dur_pt_final = union_length(ivs_pt_final)

print(f"\n[最终解] theta={np.degrees(theta_b)%360:.4f}° v={v_b:.4f} t_d={td_b:.4f} "
      f"tau={tau_b:.5f}")
print(f"[最终解] 投放点 D=({P0[0]+v_b*td_b*np.cos(theta_b):.3f}, "
      f"{P0[1]+v_b*td_b*np.sin(theta_b):.3f}, 1800.000)")
print(f"[最终解] 起爆点 B=({B_b[0]:.3f}, {B_b[1]:.3f}, {B_b[2]:.3f}), t_b={tb_b:.4f}s")
print(f"[最终解] 遮蔽区间 = {[(round(a,6), round(b,6)) for a,b in ivs_final]}")
print(f"[最终解] 体判据遮蔽时长 = {dur_final:.6f} s (复算 {dur_check:.6f})")
print(f"[G2互证] 细网格 dt=5e-4 = {dur_grid_check:.6f}s  差 {abs(dur_check-dur_grid_check):.2e}")
assert abs(dur_check - dur_grid_check) < 6e-4
print(f"[对比] 点判据 = {dur_pt_final:.6f}s ({100*(dur_pt_final/dur_check-1):+.2f}%)")

# 触地监控
t_end = min(tb_b + T_EFF, t_hit)
zmin = B_b[2] - SINK * (t_end - tb_b)
print(f"[P5监控] 云团最低 z = {zmin:.1f} m")
print(f"[Q1互证] Q1 定策略 1.3917s <= Q2 最优 {dur_final:.4f}s: {1.3917 <= dur_final}")

# ---------------- 图表 ----------------
# 图1: 收敛 + (t_b,s) 结构平面
fig, axes = plt.subplots(1, 2, figsize=(14, 5.2))
fig.suptitle('问题2: 优化收敛与结构参数平面', fontsize=14, fontweight='bold')
ax = axes[0]
t4 = np.arange(len(best4[2]))
ax.plot(t4, np.maximum(best4[2], 0), 'b-', lw=1.6, label='4D NM (含边界滑移)')
t2_ = np.arange(len(traj2_all[0]))
ax.plot(t2_, traj2_all[0], 'g-', lw=2, label='2D 精修 NM (v=70, t_d=0)')
ax.scatter([t2_[-1]], [traj2_all[0][-1]], c='red', marker='*', s=180, zorder=5,
           label=f'最优 {dur_final:.4f}s')
ax.set_xlabel('NM 迭代')
ax.set_ylabel('体判据遮蔽时长 (s)')
ax.set_title(f'收敛曲线 (结构初值 {cands[0][0]:.2f} -> 4D {dur4:.3f} -> 2D {dur_final:.4f})',
             fontsize=10.5)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=8.5)

ax = axes[1]
H = np.full((len(s_grid), len(tb_grid)), np.nan)
for i, tb in enumerate(tb_grid):
    for j, s in enumerate(s_grid):
        st = strategy_from_struct(tb, s)
        if st is not None:
            H[j, i] = duration(*st, body=False, grid_dt=0.04)
im = ax.pcolormesh(tb_grid, s_grid, H, cmap='YlOrRd', shading='auto')
plt.colorbar(im, ax=ax, label='点判据遮蔽时长 (s)')
ax.scatter([tb_b], [max(0.005, min(0.6, (B_b[2] - missile_pos('M1', tb_b)[2]) /
                                    (CENTER_PT[2] - missile_pos('M1', tb_b)[2])))],
           c='red', marker='*', s=180, edgecolor='black', zorder=5, label='最终解位置')
ax.set_xlabel('起爆时刻 t_b (s)')
ax.set_ylabel('视线分数 s')
ax.set_title('结构参数平面 (t_b, s)：非零区呈针尖形', fontsize=10.5)
ax.legend(fontsize=8.5)
F.save(fig, 'q2_optimization.png')

# 图2: v/t_d 单调性 profile（降维依据）
fig2, axes2 = plt.subplots(1, 2, figsize=(13, 4.8))
fig2.suptitle('问题2: 边界单调性证明（G5 追查）', fontsize=13, fontweight='bold')
ax = axes2[0]
ax.plot(v_scan, prof_v, 'b-o', ms=4, lw=2)
ax.scatter([70], [prof_v[0]], c='red', marker='*', s=180, zorder=5, label='v*=70 (边界即全局最优)')
ax.set_xlabel('无人机速度 v (m/s)')
ax.set_ylabel('体判据遮蔽时长 (s)')
ax.set_title('v profile: 全域单调递减', fontsize=11)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=9)
ax = axes2[1]
ax.plot(td_scan, prof_td, 'b-o', ms=4, lw=2)
ax.scatter([0], [prof_td[0]], c='red', marker='*', s=180, zorder=5, label='t_d*=0 (下界即全局最优)')
ax.set_xlabel('投放时刻 t_d (s)')
ax.set_ylabel('体判据遮蔽时长 (s)')
ax.set_title('t_d profile: 单调递减', fontsize=11)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=9)
F.save(fig2, 'q2_monotonic.png')

# 图3: 双面板轨迹
fig3, (ax_z, ax_g) = plt.subplots(2, 1, figsize=(14, 13))
tm = np.linspace(0, t_hit, 800)
Mm = missile_pos('M1', tm)
zx0, zx1 = min(P0[0], B_b[0]) - 400, max(P0[0], B_b[0]) + 400
inw = (Mm[:, 0] > zx0) & (Mm[:, 0] < zx1)
ax_z.plot(Mm[inw, 0], Mm[inw, 2], color=F.C_RED, lw=1.8, alpha=0.6, label='M1 弹道')
for k, (a, b) in enumerate(ivs_final):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_z.plot(Ms[:, 0], Ms[:, 2], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
ax_z.plot([P0[0], B_b[0]], [1800, 1800], color=F.C_BLU, lw=2.5, label='FY1 航线 (t=0 即投)')
tp = np.linspace(0, tau_b, 30)
ax_z.plot(P0[0] + v_b * tp * np.cos(theta_b), 1800 - 0.5 * G * tp ** 2,
          color=F.C_PUR, lw=2, label='弹平抛段')
ax_z.scatter([P0[0]], [1800], marker='s', s=110, c=F.C_BLU, edgecolor='darkblue', zorder=6, label='FY1 起点=投放点')
ax_z.scatter([B_b[0]], [B_b[2]], marker='*', s=300, c=F.C_BLU, edgecolor='black', zorder=7)
ax_z.annotate(f'起爆 t={tb_b:.2f}s', (B_b[0], B_b[2]), textcoords='offset points',
              xytext=(8, 10), fontsize=9, color='darkblue')
tc = np.linspace(tb_b, min(tb_b + T_EFF, t_hit), 40)
Cc = traj_cloud(B_b, tb_b, tc)
ax_z.plot(Cc[:, 0], Cc[:, 2], color=F.C_CLOUD, lw=1.5, label='云团中心下沉')
for tq, lbl in [(ivs_final[0][0], '遮蔽开始'), (ivs_final[0][1], '遮蔽结束')]:
    Mq = missile_pos('M1', float(tq))
    ax_z.scatter([Mq[0]], [Mq[2]], marker='o', s=55, c=F.C_ORG, edgecolor='black', zorder=7)
    ax_z.annotate(lbl, (Mq[0], Mq[2]), textcoords='offset points', xytext=(8, 6),
                  fontsize=8, color='darkorange')
ax_z.set_xlabel('x (m)')
ax_z.set_ylabel('z (m)')
ax_z.set_title('问题2: 投放-起爆-遮蔽 xz 侧视图', fontweight='bold')
ax_z.grid(True, ls='--', alpha=0.3)
ax_z.set_aspect('equal')
ax_z.legend(loc='lower left', fontsize=8)
ax_z.set_xlim(zx0, zx1)

ax_g.plot(Mm[:, 0], Mm[:, 1], color=F.C_RED, lw=1.2, alpha=0.55, label='M1 弹道')
for k, (a, b) in enumerate(ivs_final):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_g.plot(Ms[:, 0], Ms[:, 1], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
ax_g.plot([P0[0], B_b[0]], [P0[1], B_b[1]], color=F.C_BLU, lw=2, alpha=0.85, label='FY1 航线')
F.draw_targets(ax_g)
ax_g.scatter([P0[0]], [P0[1]], marker='s', s=70, c=F.C_BLU, edgecolor='darkblue', label='FY1 起点=投放点')
ax_g.scatter([B_b[0]], [B_b[1]], marker='*', s=200, c=F.C_BLU, edgecolor='black', label='起爆点')
ax_g.annotate(f'真目标(0,200)  v={v_b:.0f}m/s, t_d=0', xy=(0.03, 0.05),
              xycoords='axes fraction', fontsize=8,
              bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkgreen'))
F.setup_map_axes(ax_g, '问题2: 全局态势 (xy)')
ax_g.legend(loc='center right', fontsize=9)
F.save(fig3, 'q2_trajectory.png')

# ---------------- 结果表 ----------------
out_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output')
tab_dir = os.path.join(out_dir, 'tables')
D_b = P0 + v_b * td_b * np.array([np.cos(theta_b), np.sin(theta_b), 0.0])
rows = [
    ['航向角 theta (deg)', f'{np.degrees(theta_b)%360:.4f}'],
    ['速度 v (m/s)', f'{v_b:.4f}'],
    ['投放时刻 t_d (s)', f'{td_b:.4f}'],
    ['引信延迟 tau (s)', f'{tau_b:.5f}'],
    ['投放点 D (m)', f'({D_b[0]:.3f}, {D_b[1]:.3f}, {D_b[2]:.3f})'],
    ['起爆点 B (m)', f'({B_b[0]:.3f}, {B_b[1]:.3f}, {B_b[2]:.3f})'],
    ['起爆时刻 t_b (s)', f'{tb_b:.5f}'],
    ['体判据遮蔽区间 (s)', f'[{ivs_final[0][0]:.6f}, {ivs_final[0][1]:.6f}]'],
    ['体判据遮蔽时长 (s)', f'{dur_check:.6f}'],
    ['点判据时长 (s)', f'{dur_pt_final:.6f}'],
    ['G2网格互证 (s)', f'{dur_grid_check:.6f}'],
    ['4D NM候选(降维前) (s)', f'{dur4:.6f}'],
]
pd.DataFrame(rows, columns=['量', '值']).to_csv(
    os.path.join(tab_dir, 'q2_results.csv'), index=False, encoding='utf-8-sig')
print("  [表] q2_results.csv + 3 图")
print(f"\n总运行时间: {time.time()-t_start_all:.1f} s")

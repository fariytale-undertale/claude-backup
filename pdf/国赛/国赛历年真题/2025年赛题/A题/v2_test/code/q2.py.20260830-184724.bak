# -*- coding: utf-8 -*-
"""问题2：FY1 单弹对 M1 遮蔽时长最大化。

求解器（G-Cost 闸门已做形态诊断：非零占比 0% -> 稀疏针尖形 -> 结构驱动）：
  结构推导（A2+A3 消元）: 起爆点水平位置 B_h = P0_h + v*t_b*u（弹平抛水平位移 = 无人机水平位移）
    => 给定 (t_b, s)：云心置于 t_b 时刻视线 M1(t_b)->目标 的分数 s 处，
       tau = sqrt(2*(1800-B_z)/g)（由起爆高度反解平抛时长），t_d = t_b - tau,
       v = |B_h - P0_h| / t_b（须在 [70,140]），u = 单位化(B_h - P0_h)。
  流程: (t_b, s) 粗网格 -> 点判据快速排序 -> 体判据核验 top-K -> NM 4D 局部精化 (K=8 起点数纪律)
       -> G3 全参数域随机探查（独立验证无结构族外非零区） -> G2 异源互证 -> G5 边界哨兵。
"""
import sys, os, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from scipy.optimize import minimize
from core import (burst_pos, T_HIT, CYL_PTS, CENTER_PT, shaded_intervals,
                  shaded_intervals_point, union_length, grid_union_length,
                  V_UAV_MIN, V_UAV_MAX, G, UAVS, E_M, V_MISSILE, R_CLOUD, SINK, T_EFF)
import figures as F

t_start_all = time.time()
t_hit = T_HIT['M1']
P0 = UAVS['FY1']
PT = CENTER_PT          # 视线终点用柱心（构造热启动用；评估仍用体判据）

from core import missile_pos


def m1_at(t):
    return missile_pos('M1', float(t))


def strategy_from_struct(t_b, s):
    """(t_b, s) -> (theta, v, t_d, tau) 或 None（不可行）。"""
    M = m1_at(t_b)
    B = M + s * (PT - M)                      # 起爆点 = 视线分数 s 处
    if B[2] >= 1800.0 or B[2] <= 0:
        return None
    tau = np.sqrt(2.0 * (1800.0 - B[2]) / G)
    t_d = t_b - tau
    if t_d < 0.0:
        return None
    dh = B[:2] - P0[:2]
    L = np.linalg.norm(dh)
    v = L / t_b
    if v < V_UAV_MIN - 1e-9 or v > V_UAV_MAX + 1e-9:
        return None
    theta = np.arctan2(dh[1], dh[0]) % (2 * np.pi)
    return theta, v, t_d, tau


def duration(theta, v, t_d, tau, body=True, grid_dt=0.005):
    """体/点判据遮蔽时长。参数非法（z_B<0）返回 -1 标记不可行。"""
    if tau <= 0 or t_d < 0:
        return -1.0
    B = burst_pos('FY1', t_d, tau, theta, v)
    if B[2] < 0:
        return -1.0
    if body:
        ivs = shaded_intervals(B, t_d + tau, 'M1', CYL_PTS, t_hit, grid_dt=grid_dt)
    else:
        ivs = shaded_intervals_point(B, t_d + tau, 'M1', t_hit, grid_dt=grid_dt)
    return union_length(ivs)


# ---------------------------------------------------------- 阶段1: 结构热启动
t1 = time.time()
tb_grid = np.linspace(1.0, 25.0, 49)       # 起爆时刻网格（0.5 s 步长）
s_grid = np.linspace(0.01, 0.60, 30)       # 视线分数（近导弹端收益小，限制在近目标半程）
cands = []
for tb in tb_grid:
    for s in s_grid:
        st = strategy_from_struct(tb, s)
        if st is None:
            continue
        d_pt = duration(*st, body=False, grid_dt=0.02)   # 点判据快速排序
        if d_pt > 0:
            cands.append((d_pt, tb, s, st))
print(f"[阶段1 结构热启动] 粗网格 {len(tb_grid)}x{len(s_grid)}，可行候选 {len(cands)} 个，"
      f"耗时 {time.time()-t1:.1f}s")
cands.sort(key=lambda x: -x[0])
topK = 8
print("[阶段1] 点判据 top-8 初值:")
for d_pt, tb, s, st in cands[:topK]:
    print(f"   t_b={tb:.1f} s={s:.3f} -> 点判据 {d_pt:.3f}s | "
          f"th={np.degrees(st[0])%360:.1f} v={st[1]:.1f} t_d={st[2]:.2f} tau={st[3]:.2f}")

# ---------------------------------------------------------- 阶段2: NM 4D 局部精化
t2 = time.time()
# 决策变量 x = [theta, v, t_d, tau]；惩罚不可行
def neg_dur_x(x):
    th, v, td, tau = x
    if not (V_UAV_MIN - 1e-6 <= v <= V_UAV_MAX + 1e-6 and td >= 0 and tau > 0):
        return 10.0
    d = duration(th % (2 * np.pi), v, td, tau, body=True, grid_dt=0.005)
    return -d if d > 0 else 10.0 + abs(d)   # 不可行给大罚

best = None
for d_pt, tb0, s0, st0 in cands[:topK]:
    res = minimize(neg_dur_x, np.array(st0), method='Nelder-Mead',
                   options={'maxfev': 400, 'xatol': 1e-6, 'fatol': 1e-9})
    if best is None or -res.fun > best[0]:
        best = (-res.fun, res.x.copy())
    print(f"   NM from t_b={tb0:.1f}: {(-res.fun if res.fun<10 else 0):.4f}s "
          f"(nfev={res.nfev})")
theta_b = best[1][0] % (2 * np.pi)
v_b, td_b, tau_b = best[1][1], best[1][2], best[1][3]
dur_nm = best[0]
print(f"[阶段2 NM精化] K={topK} 起点，耗时 {time.time()-t2:.1f}s，"
      f"最优 {dur_nm:.6f}s @ th={np.degrees(theta_b)%360:.3f}° v={v_b:.3f} t_d={td_b:.4f} tau={tau_b:.4f}")

# ---------------------------------------------------------- 阶段3: G3 全参数域探查
t3 = time.time()
rng = np.random.default_rng(7)
N_probe = 1500
ths = rng.uniform(0, 2 * np.pi, N_probe)
vs = rng.uniform(V_UAV_MIN, V_UAV_MAX, N_probe)
tds = rng.uniform(0.0, 25.0, N_probe)
taus = rng.uniform(0.2, 14.0, N_probe)
durs_probe = np.array([duration(a, b, c, d, body=False, grid_dt=0.02) for a, b, c, d in zip(ths, vs, tds, taus)])
nz = durs_probe > 1e-9
print(f"[阶段3 G3探查] 全参数域随机 {N_probe} 点（点判据, dt=0.02），非零 {nz.sum()} 个 "
      f"({nz.mean()*100:.2f}%), 耗时 {time.time()-t3:.1f}s")
if nz.any():
    i = np.argmax(durs_probe)
    print(f"   随机最优 {durs_probe[i]:.4f}s @ th={np.degrees(ths[i])%360:.1f} v={vs[i]:.1f} "
          f"td={tds[i]:.2f} tau={taus[i]:.2f}")
    # 非零点若显著低于结构解 -> 结构族已覆盖非零区
print(f"[阶段3] 结构解 {dur_nm:.4f}s vs 随机探查最优 "
      f"{(durs_probe.max() if nz.any() else 0):.4f}s "
      f"-> {'结构族覆盖非零区' if dur_nm >= durs_probe.max() - 1e-6 or not nz.any() else '警告: 存在结构族外更优'}")

# 结构 (t_b, s) 平面加密扫描（全参数域的有效降维验证）
tb_fine = np.linspace(0.8, 28.0, 137)
s_fine = np.linspace(0.005, 0.8, 60)
best_struct = (0, None)
n_feas = 0
t3b = time.time()
for tb in tb_fine:
    for s in s_fine:
        st = strategy_from_struct(tb, s)
        if st is None:
            continue
        n_feas += 1
        d_pt = duration(*st, body=False, grid_dt=0.02)
        if d_pt > best_struct[0]:
            best_struct = (d_pt, (tb, s, st))
print(f"[阶段3] 结构平面加密扫 {n_feas} 可行点，耗时 {time.time()-t3b:.1f}s，"
      f"结构族内点判据最优 {best_struct[0]:.4f}s @ t_b={best_struct[1][0]:.2f} s={best_struct[1][1]:.3f}")

# ---------------------------------------------------------- 阶段4: 最终确认（精确网格）+ G2 互证
B_b = burst_pos('FY1', td_b, tau_b, theta_b, v_b)
tb_b = td_b + tau_b
ivs_final = shaded_intervals(B_b, tb_b, 'M1', CYL_PTS, t_hit, grid_dt=0.002)
dur_final = union_length(ivs_final)
dur_grid_check, _ = grid_union_length([(B_b, tb_b)], 'M1', CYL_PTS, t_hit, dt=0.0005)
print(f"\n[最终] 遮蔽区间 = {[(round(a,6), round(b,6)) for a,b in ivs_final]}")
print(f"[最终] 体判据遮蔽时长 = {dur_final:.6f} s")
print(f"[G2互证] 细网格 dt=5e-4 = {dur_grid_check:.6f}s  差 {abs(dur_final-dur_grid_check):.2e}")
assert abs(dur_final - dur_grid_check) < 6e-4

# 点判据对比（跨抽象层报告）
ivs_pt_final = shaded_intervals_point(B_b, tb_b, 'M1', t_hit, grid_dt=0.002)
dur_pt_final = union_length(ivs_pt_final)
print(f"[对比] 点判据时长 = {dur_pt_final:.6f}s ({100*(dur_pt_final/dur_final-1):+.2f}%)")

# G5 边界哨兵
bounds = {'v': (V_UAV_MIN, V_UAV_MAX), 't_d': (0, None), 'tau': (0, None)}
flags = []
if min(abs(v_b - V_UAV_MIN), abs(v_b - V_UAV_MAX)) < 0.5:
    flags.append(f"v 卡边界 {v_b:.2f}")
if td_b < 0.2:
    flags.append(f"t_d 卡下界 {td_b:.3f}")
Bz = B_b[2]
print(f"[G5边界哨兵] v={v_b:.3f} (70~140), t_d={td_b:.4f}, tau={tau_b:.4f}, z_B={Bz:.1f} -> "
      f"{'警告: ' + ';'.join(flags) if flags else '无卡边界'}")

# 触地监控
t_end = min(tb_b + T_EFF, t_hit)
zmin = B_b[2] - SINK * (t_end - tb_b)
print(f"[P5监控] 云团最低 z = {zmin:.1f} m")
print(f"[Q1互证] Q1 定策略 1.3917s <= Q2 最优 {dur_final:.4f}s: {1.3917 <= dur_final}")

# ---------------------------------------------------------- 图表
# 收敛图：NM 各起点迭代
# 重新跑 best 起点的 NM 记录轨迹
traj = [neg_dur_x(np.array(st0))]
def cb(xk):
    traj.append(neg_dur_x(xk))
res_traj = minimize(neg_dur_x, np.array(cands[0][3]), method='Nelder-Mead',
                    options={'maxfev': 400, 'xatol': 1e-6, 'fatol': 1e-9}, callback=cb)
gens = np.arange(len(traj))
vals = -np.array(traj)

fig, axes = plt.subplots(1, 2, figsize=(14, 5.2))
fig.suptitle('问题2: 优化过程与敏感度', fontsize=14, fontweight='bold')
ax = axes[0]
ax.plot(gens, vals, 'b-', lw=2)
ax.scatter([gens[-1]], [vals[-1]], c='red', marker='*', s=180, zorder=5,
           label=f'最优 {vals[-1]:.4f}s')
ax.set_xlabel('NM 迭代')
ax.set_ylabel('体判据遮蔽时长 (s)')
ax.set_title(f'收敛曲线 (初值 {vals[0] if vals[0]>0 else 0:.3f}s -> 终值 {vals[-1]:.4f}s)',
             fontsize=11)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=9)

ax = axes[1]
# t_b-s 结构平面热力图（点判据快速评估，示非零区形状）
H = np.full((len(s_fine), len(tb_fine)), np.nan)
for i, tb in enumerate(tb_fine):
    for j, s in enumerate(s_fine):
        st = strategy_from_struct(tb, s)
        if st is not None:
            H[j, i] = duration(*st, body=False, grid_dt=0.04)
im = ax.pcolormesh(tb_fine, s_fine, H, cmap='YlOrRd', shading='auto')
plt.colorbar(im, ax=ax, label='点判据遮蔽时长 (s)')
if best_struct[1] is not None:
    ax.scatter([best_struct[1][0]], [best_struct[1][1]], c='red', marker='*', s=180,
               edgecolor='black', zorder=5, label='结构最优')
ax.set_xlabel('起爆时刻 t_b (s)')
ax.set_ylabel('视线分数 s')
ax.set_title('结构参数平面 (t_b, s) 非零区（针尖形证实）', fontsize=11)
ax.legend(fontsize=9)
F.save(fig, 'q2_optimization.png')

# 敏感度图：v 与 tau 的 1D 扫描（最优邻域 ±10%）
fig2, axes2 = plt.subplots(1, 2, figsize=(13, 4.8))
fig2.suptitle('问题2: 最优解敏感度（体判据，±10% 邻域）', fontsize=13, fontweight='bold')
v_scan = np.linspace(0.9 * v_b, 1.1 * v_b, 21)
d_v = [duration(theta_b, vv, td_b, tau_b, grid_dt=0.01) for vv in v_scan]
ax = axes2[0]
ax.plot(v_scan, d_v, 'b-', lw=2)
ax.scatter([v_b], [dur_final], c='red', marker='*', s=160, zorder=5, label=f'最优 v={v_b:.1f}')
ax.set_xlabel('无人机速度 v (m/s)')
ax.set_ylabel('遮蔽时长 (s)')
ax.set_title('速度敏感度', fontsize=11)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=9)
tau_scan = np.linspace(0.9 * tau_b, 1.1 * tau_b, 21)
d_tau = []
for tt in tau_scan:
    # 固定 B 不变反解 t_d（tau 变则 t_d 变保持同一起爆点）
    td_new = tb_b - tt
    d_tau.append(duration(theta_b, v_b, td_new, tt, grid_dt=0.01) if td_new >= 0 else 0)
ax = axes2[1]
ax.plot(tau_scan, d_tau, 'b-', lw=2)
ax.scatter([tau_b], [dur_final], c='red', marker='*', s=160, zorder=5, label=f'最优 tau={tau_b:.2f}')
ax.set_xlabel('引信延迟 tau (s)')
ax.set_ylabel('遮蔽时长 (s)')
ax.set_title('引信延迟敏感度（固定起爆点）', fontsize=11)
ax.grid(True, ls='--', alpha=0.3)
ax.legend(fontsize=9)
F.save(fig2, 'q2_sensitivity.png')

# 轨迹图（俯视双面板）
fig3 = plt.figure(figsize=(14, 6))
ax_g = fig3.add_axes([0.58, 0.12, 0.39, 0.74])
ax_z = fig3.add_axes([0.06, 0.12, 0.48, 0.74])
tm = np.linspace(0, t_hit, 800)
Mm = missile_pos('M1', tm) if False else None
from core import missile_pos
Mm = missile_pos('M1', tm)
ax_g.plot(Mm[:, 0], Mm[:, 1], color=F.C_RED, lw=1.2, alpha=0.55, label='M1 弹道')
for k, (a, b) in enumerate(ivs_final):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_g.plot(Ms[:, 0], Ms[:, 1], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
u_pts = np.array([[P0[0] + v_b * t * np.cos(theta_b), P0[1] + v_b * t * np.sin(theta_b)]
                  for t in [0, td_b, tb_b]])
ax_g.plot(u_pts[:, 0], u_pts[:, 1], color=F.C_BLU, lw=2, alpha=0.85, label='FY1 航线')
F.draw_targets(ax_g)
ax_g.scatter([u_pts[0, 0]], [u_pts[0, 1]], marker='s', s=70, c=F.C_BLU, edgecolor='darkblue', label='FY1 起点')
ax_g.scatter([u_pts[1, 0]], [u_pts[1, 1]], marker='^', s=70, c=F.C_RED, edgecolor='darkred', label='投放点')
ax_g.scatter([B_b[0]], [B_b[1]], marker='*', s=200, c=F.C_BLU, edgecolor='black', label='起爆点')
ax_g.annotate(f'真目标(0,200) v={v_b:.1f}m/s', xy=(0.03, 0.05), xycoords='axes fraction', fontsize=8,
              bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkgreen'))
F.setup_map_axes(ax_g, '问题2: 全局态势 (xy)')
ax_g.legend(loc='upper left', fontsize=8)

# 局部 xz
zx0, zx1 = min(u_pts[:, 0].min(), B_b[0]) - 400, max(u_pts[:, 0].max(), B_b[0]) + 400
inw = (Mm[:, 0] > zx0) & (Mm[:, 0] < zx1)
ax_z.plot(Mm[inw, 0], Mm[inw, 2], color=F.C_RED, lw=1.8, alpha=0.6, label='M1 弹道')
for k, (a, b) in enumerate(ivs_final):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_z.plot(Ms[:, 0], Ms[:, 2], color=F.C_RED, lw=3.5, alpha=0.95, label='M1 遮蔽段' if k == 0 else None)
ax_z.plot([P0[0], u_pts[1, 0]], [1800, 1800], color=F.C_BLU, lw=2.5, label='FY1 航线')
tp = np.linspace(0, tau_b, 30)
ax_z.plot(u_pts[1, 0] + v_b * tp * np.cos(theta_b), 1800 - 0.5 * G * tp ** 2,
          color=F.C_PUR, lw=2, label='弹平抛段')
ax_z.scatter([P0[0]], [1800], marker='s', s=100, c=F.C_BLU, edgecolor='darkblue', label='FY1 起点')
ax_z.scatter([u_pts[1, 0]], [1800], marker='^', s=100, c=F.C_RED, edgecolor='darkred')
ax_z.annotate(f'投放 t={td_b:.2f}s', (u_pts[1, 0], 1800), textcoords='offset points',
              xytext=(8, 10), fontsize=9, color='darkred')
ax_z.scatter([B_b[0]], [B_b[2]], marker='*', s=280, c=F.C_BLU, edgecolor='black')
ax_z.annotate(f'起爆 t={tb_b:.2f}s', (B_b[0], B_b[2]), textcoords='offset points',
              xytext=(8, 10), fontsize=9, color='darkblue')
tc = np.linspace(tb_b, min(tb_b + T_EFF, t_hit), 40)
Cc = traj_cloud(B_b, tb_b, tc)
ax_z.plot(Cc[:, 0], Cc[:, 2], color=F.C_CLOUD, lw=1.5, label='云团中心下沉')
ax_z.set_xlabel('x (m)')
ax_z.set_ylabel('z (m)')
ax_z.set_title('问题2: 投放-起爆 xz 侧视图', fontweight='bold')
ax_z.grid(True, ls='--', alpha=0.3)
ax_z.set_aspect('equal')
ax_z.legend(loc='upper left', fontsize=8)
ax_z.set_xlim(zx0, zx1)
F.save(fig3, 'q2_trajectory.png')

# 结果表
import pandas as pd
tab_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output', 'tables')
rows = [
    ['航向角 theta (deg)', f'{np.degrees(theta_b)%360:.4f}'],
    ['速度 v (m/s)', f'{v_b:.4f}'],
    ['投放时刻 t_d (s)', f'{td_b:.4f}'],
    ['引信延迟 tau (s)', f'{tau_b:.4f}'],
    ['投放点 D (m)', f'({u_pts[1,0]:.3f}, {u_pts[1,1]:.3f}, 1800.000)'],
    ['起爆点 B (m)', f'({B_b[0]:.3f}, {B_b[1]:.3f}, {B_b[2]:.3f})'],
    ['起爆时刻 t_b (s)', f'{tb_b:.4f}'],
    ['体判据遮蔽区间 (s)', f'{[(round(a,4),round(b,4)) for a,b in ivs_final]}'],
    ['体判据遮蔽时长 (s)', f'{dur_final:.4f}'],
    ['点判据时长 (s)', f'{dur_pt_final:.4f}'],
    ['G2网格互证 (s)', f'{dur_grid_check:.4f}'],
    ['G3随机探查最优 (s)', f'{(durs_probe.max() if nz.any() else 0):.4f}'],
]
pd.DataFrame(rows, columns=['量', '值']).to_csv(
    os.path.join(tab_dir, 'q2_results.csv'), index=False, encoding='utf-8-sig')
print(f"  [表] q2_results.csv")
print(f"\n总运行时间: {time.time()-t_start_all:.1f} s")

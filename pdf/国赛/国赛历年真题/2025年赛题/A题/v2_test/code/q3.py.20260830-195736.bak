# -*- coding: utf-8 -*-
"""问题3：FY1 投 3 枚弹对 M1 遮蔽时长最大化（并集口径）。

结构：继承问题2 的结构参数化（每弹 (t_b_i, s_i)，由几何反解 (theta_i, v_i, t_d_i, tau_i)），
     但同一架无人机的 (theta, v) 只有一组——三弹共享航向/速度，仅投放时刻不同。
     => 参数化改为 (theta, v) + 3x(t_d, tau)：先在结构平面找三弹各自最优的视线位置，
        再检验能否用同一 (theta,v) 实现；联合优化 8 维 (theta,v,td1,tau1,td2,tau2,td3,tau3)。
约束：同机两弹投放间隔 >= 1 s（排序后相邻差 >= 1）。
G2: 贪心（逐弹在 Q2 最优基础上加弹）vs 联合 8 维 NM，两法互证。
"""
import sys, os, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from scipy.optimize import minimize
from core import (burst_pos, T_HIT, CYL_PTS, CENTER_PT, shaded_intervals,
                  shaded_intervals_point, union_length, grid_union_length,
                  V_UAV_MIN, V_UAV_MAX, G, UAVS, missile_pos, DT_MIN, SINK, T_EFF)
import figures as F
import pandas as pd

t_start_all = time.time()
t_hit = T_HIT['M1']
P0 = UAVS['FY1']
PT = CENTER_PT


def strategy_from_struct(t_b, s):
    M = missile_pos('M1', float(t_b))
    B = M + s * (PT - M)
    if B[2] >= 1800.0 or B[2] <= 0:
        return None
    tau = np.sqrt(2.0 * (1800.0 - B[2]) / G)
    t_d = t_b - tau
    if t_d < 0:
        return None
    dh = B[:2] - P0[:2]
    v = np.linalg.norm(dh) / t_b
    if v < V_UAV_MIN - 1e-9 or v > V_UAV_MAX + 1e-9:
        return None
    theta = np.arctan2(dh[1], dh[0]) % (2 * np.pi)
    return theta, v, t_d, tau


def intervals_for(theta, v, td, tau, body=True, grid_dt=0.005):
    if tau <= 0 or td < 0:
        return []
    B = burst_pos('FY1', td, tau, theta, v)
    if B[2] < 0:
        return []
    if body:
        return shaded_intervals(B, td + tau, 'M1', CYL_PTS, t_hit, grid_dt=grid_dt)
    return shaded_intervals_point(B, td + tau, 'M1', t_hit, grid_dt=grid_dt)


def total_union(theta, v, params, body=True, grid_dt=0.005):
    """params = [(td,tau)x3]。含间隔约束罚。"""
    tds = sorted(p[0] for p in params if p[0] >= 0)
    if any(tds[i + 1] - tds[i] < DT_MIN - 1e-9 for i in range(len(tds) - 1)):
        return -1.0, []
    ivs = []
    for td, tau in params:
        if td < 0 or tau <= 0:
            continue
        ivs += intervals_for(theta, v, td, tau, body=body, grid_dt=grid_dt)
    return union_length(ivs), ivs


# ---- Q2 最优解（从 q2_results.csv 读回，保证跨问一致）----
q2_tab = pd.read_csv(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                  '..', 'output', 'tables', 'q2_results.csv'))
q2 = dict(zip(q2_tab['量'], q2_tab['值']))
theta2 = np.radians(float(q2['航向角 theta (deg)']))
v2 = float(q2['速度 v (m/s)'])
td2_1 = float(q2['投放时刻 t_d (s)'])
tau2_1 = float(q2['引信延迟 tau (s)'])
q2_dur = float(q2['体判据遮蔽时长 (s)'])
print(f"[继承Q2] th={np.degrees(theta2):.3f}° v={v2:.3f} td={td2_1:.4f} tau={tau2_1:.4f} "
      f"时长={q2_dur:.4f}s")

# ------------------------------------------------ 贪心基线：在 Q2 基础上加 2 弹
t1 = time.time()
# 直接在 (theta2,v2) 下扫 (td, tau) 平面（0.25s x 0.5s 步长）
tds_g = np.arange(0.0, 30.0, 0.25)
taus_g = np.arange(0.5, 12.0, 0.5)
best_first = []
for td in tds_g:
    for tau in taus_g:
        ivs = intervals_for(theta2, v2, td, tau, body=False, grid_dt=0.02)
        d = union_length(ivs)
        if d > 0:
            best_first.append((d, td, tau))
best_first.sort(key=lambda x: -x[0])
print(f"[贪心] (th,v)=(Q2最优) 下 (td,tau) 网格点判据非零 {len(best_first)} 个，耗时 {time.time()-t1:.1f}s")
print(f"[贪心] top: {[(round(d,3), round(td,2), round(tau,2)) for d, td, tau in best_first[:10]]}")

# 贪心逐弹选取（间隔>=1s；不足 3 弹时以零时长占位弹补足维度，NM 阶段再优化）
selected = []
pool = best_first.copy()
for k in range(3):
    for d, td, tau in pool:
        if all(abs(td - td_sel) >= DT_MIN for td_sel, _ in selected):
            selected.append((td, tau))
            pool = [x for x in pool if x[0] != d or x[1] != td]
            break
    else:
        # 窗口外补一个远端占位弹（零时长，NM 可拉回）
        td_pad = 1.0 + k * 1.5
        while any(abs(td_pad - td_sel) < DT_MIN for td_sel, _ in selected):
            td_pad += 1.0
        selected.append((td_pad, 2.0))
print(f"[贪心] 选中 3 弹: {[(round(td,2), round(tau,2)) for td, tau in selected]}")
d_greedy, ivs_greedy = total_union(theta2, v2, selected, body=True, grid_dt=0.005)
print(f"[贪心] 体判据并集时长 = {d_greedy:.4f}s  (Q2 单弹 {q2_dur:.4f}s)")

# ------------------------------------------------ 联合 8 维 NM（贪心解 + Q2 单弹解双起点）
def neg_obj(x):
    th = x[0] % (2 * np.pi)
    v = x[1]
    params = [(x[2 + 2 * i], x[3 + 2 * i]) for i in range(3)]
    d, _ = total_union(th, v, params, body=False, grid_dt=0.02)
    if d < 0:
        return 10.0 - d
    return -d

starts = []
# 起点1: 贪心解
g0 = [theta2, v2] + [x for p in selected for x in p]
starts.append(np.array(g0))
# 起点2: Q2 单弹 + 两个结构次优弹
for extra in [best_first[3], best_first[7], best_first[12]]:
    pass
q2_full = [td2_1, tau2_1]
# 取与 Q2 弹错开 >=1s 的次优点（不足则远端占位）
extras = []
for d, td, tau in best_first:
    if abs(td - q2_full[0]) >= DT_MIN and all(abs(td - e[0]) >= DT_MIN for e in extras):
        extras.append((td, tau))
    if len(extras) == 2:
        break
k = 0
while len(extras) < 2:
    td_pad = 3.0 + k * 1.5
    if all(abs(td_pad - e[0]) >= DT_MIN for e in extras) and abs(td_pad - q2_full[0]) >= DT_MIN:
        extras.append((td_pad, 2.0))
    k += 1
s2 = [theta2, v2, q2_full[0], q2_full[1]] + [x for p in extras for x in p]
starts.append(np.array(s2))

best_joint = None
t2 = time.time()
for i, x0 in enumerate(starts):
    res = minimize(neg_obj, x0, method='Nelder-Mead',
                   options={'maxfev': 3000, 'xatol': 1e-6, 'fatol': 1e-9})
    val = -res.fun if res.fun < 10 else 0
    print(f"[联合NM 起点{i+1}] {val:.4f}s (nfev={res.nfev})")
    if best_joint is None or val > best_joint[0]:
        best_joint = (val, res.x.copy())
xj = best_joint[1]
theta_j = xj[0] % (2 * np.pi)
v_j = xj[1]
params_j = sorted([(xj[2 + 2 * i], xj[3 + 2 * i]) for i in range(3)])
dur_joint, ivs_joint = total_union(theta_j, v_j, params_j, body=True, grid_dt=0.002)
print(f"[联合NM] 精化后体判据并集 = {dur_joint:.4f}s，耗时 {time.time()-t2:.1f}s")

# G2: 启发式(贪心) vs 联合优化 对比
if dur_joint >= d_greedy:
    verdict = '联合优化 >= 贪心（正常），取联合解'
    dur_final, theta_f, v_f, params_f, ivs_f = dur_joint, theta_j, v_j, params_j, ivs_joint
else:
    verdict = '警告: 贪心 > 联合（联合NM未收敛），取贪心解并查NM'
    dur_final, theta_f, v_f, params_f, ivs_f = d_greedy, theta2, v2, selected, ivs_greedy
print(f"[G2] {verdict}: 联合 {dur_joint:.4f} vs 贪心 {d_greedy:.4f} -> 采用 {dur_final:.4f}s")

# G2 互证（异源细网格）
bursts = [(burst_pos('FY1', td, tau, theta_f, v_f), td + tau) for td, tau in params_f]
dur_grid_check, _ = grid_union_length(bursts, 'M1', CYL_PTS, t_hit, dt=0.0005)
print(f"[G2互证] 细网格 dt=5e-4 = {dur_grid_check:.4f}s  |差| = {abs(dur_final-dur_grid_check):.2e}")
assert abs(dur_final - dur_grid_check) < 8e-4

# G5 边界哨兵
flags = []
if min(abs(v_f - V_UAV_MIN), abs(v_f - V_UAV_MAX)) < 0.5:
    flags.append(f'v卡边界{v_f:.2f}')
tdsf = [p[0] for p in params_f]
for i in range(2):
    if abs(tdsf[i + 1] - tdsf[i] - DT_MIN) < 0.05:
        flags.append(f'弹{i+1}-{i+2}间隔卡1s下界')
print(f"[G5] {'; '.join(flags) if flags else '无卡边界'};  t_d = {[round(t,3) for t in tdsf]}")

# 逐弹单独时长（result1 表）
rows = []
per_ball_durs = []
for i, (td, tau) in enumerate(params_f):
    ivs_i = intervals_for(theta_f, v_f, td, tau, body=True, grid_dt=0.002)
    di = union_length(ivs_i)
    per_ball_durs.append(di)
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0])
    rows.append([np.degrees(theta_f) % 360, v_f, i + 1,
                 D[0], D[1], D[2], B[0], B[1], B[2], di])
print("逐弹时长: " + ", ".join(f"弹{i+1}={d:.4f}" for i, d in enumerate(per_ball_durs)))
print(f"并集(报告值) = {dur_final:.4f}s   逐弹和 = {sum(per_ball_durs):.4f}s (可重叠)")

# 触地监控
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    tb_i = td + tau
    zend = B[2] - SINK * (min(tb_i + T_EFF, t_hit) - tb_i)
    if zend <= 0:
        print(f"[P5警告] 弹{i+1} 云团触地 z={zend:.1f}")

# ------------------------------------------------ 图表
F.gantt([[iv for iv in intervals_for(theta_f, v_f, td, tau, body=True, grid_dt=0.002)]
         for td, tau in params_f],
        [f'弹{i+1}' for i in range(3)], [[td] for td, _ in params_f],
        '问题3: 三弹遮蔽区间甘特图（并集总时长 %.3f s）' % dur_final,
        'q3_gantt.png')

fig3 = plt.figure(figsize=(14, 6))
ax_g = fig3.add_axes([0.58, 0.12, 0.39, 0.74])
ax_z = fig3.add_axes([0.06, 0.12, 0.48, 0.74])
tm = np.linspace(0, t_hit, 800)
Mm = missile_pos('M1', tm)
ax_g.plot(Mm[:, 0], Mm[:, 1], color=F.C_RED, lw=1.2, alpha=0.55, label='M1 弹道')
for k, (a, b) in enumerate(ivs_f):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_g.plot(Ms[:, 0], Ms[:, 1], color=F.C_RED, lw=3.5, alpha=0.95,
              label='M1 遮蔽段' if k == 0 else None)
u_line = [P0[0] + v_f * t * np.cos(theta_f) for t in [0, max(tdsf) + 2]]
u_line_y = [P0[1] + v_f * t * np.sin(theta_f) for t in [0, max(tdsf) + 2]]
ax_g.plot(u_line, u_line_y, color=F.C_BLU, lw=2, alpha=0.85, label='FY1 航线')
F.draw_targets(ax_g)
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0])
    ax_g.scatter([D[0]], [D[1]], marker='^', s=70, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_g.scatter([B[0]], [B[1]], marker='*', s=190, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_g.annotate(f'弹{i+1}', (B[0], B[1]), textcoords='offset points', xytext=(6, 6),
                  fontsize=8, color=F.SERIES[i])
ax_g.scatter([], [], marker='^', s=60, c='black', label='投放点(=弹色)')
ax_g.scatter([], [], marker='*', s=160, c='black', label='起爆点(=弹色)')
ax_g.annotate(f'真目标(0,200)  v={v_f:.1f}m/s', xy=(0.03, 0.05), xycoords='axes fraction',
              fontsize=8, bbox=dict(boxstyle='round', facecolor='lightyellow', edgecolor='darkgreen'))
F.setup_map_axes(ax_g, '问题3: 全局态势 (xy)')
ax_g.legend(loc='upper left', fontsize=8)

xmaxs = [P0[0] + v_f * t * np.cos(theta_f) for t in [0, max(tdsf)]]
zx0 = min(min(xmaxs), min(b[0] for b, _ in bursts)) - 300
zx1 = max(max(xmaxs), max(b[0] for b, _ in bursts)) + 300
inw = (Mm[:, 0] > zx0) & (Mm[:, 0] < zx1)
ax_z.plot(Mm[inw, 0], Mm[inw, 2], color=F.C_RED, lw=1.8, alpha=0.6, label='M1 弹道')
for k, (a, b) in enumerate(ivs_f):
    tseg = np.linspace(a, b, 60)
    Ms = missile_pos('M1', tseg)
    ax_z.plot(Ms[:, 0], Ms[:, 2], color=F.C_RED, lw=3.5, alpha=0.95, label='M1 遮蔽段' if k == 0 else None)
ax_z.plot([P0[0], P0[0] + v_f * (max(tdsf) + 1) * np.cos(theta_f)], [1800, 1800],
          color=F.C_BLU, lw=2.5, label='FY1 航线')
for i, (td, tau) in enumerate(params_f):
    B = burst_pos('FY1', td, tau, theta_f, v_f)
    D = P0 + v_f * td * np.array([np.cos(theta_f), np.sin(theta_f), 0])
    tp = np.linspace(0, tau, 30)
    ax_z.plot(D[0] + v_f * tp * np.cos(theta_f), 1800 - 0.5 * G * tp ** 2,
              color=F.SERIES[i], lw=1.8, alpha=0.9)
    ax_z.scatter([D[0]], [D[2]], marker='^', s=90, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_z.scatter([B[0]], [B[2]], marker='*', s=240, c=F.SERIES[i], edgecolor='black', zorder=6)
    ax_z.annotate(f'弹{i+1} 起爆 t={td+tau:.1f}s', (B[0], B[2]), textcoords='offset points',
                  xytext=(6, 8), fontsize=8, color=F.SERIES[i])
tc_all = []
for b, tb_i in bursts:
    tc = np.linspace(tb_i, min(tb_i + T_EFF, t_hit), 30)
    Cc = traj_cloud(b, tb_i, tc)
    ax_z.plot(Cc[:, 0], Cc[:, 2], color=F.C_CLOUD, lw=1.2, alpha=0.8)
ax_z.set_xlabel('x (m)')
ax_z.set_ylabel('z (m)')
ax_z.set_title('问题3: 三弹投放-起爆 xz 侧视图', fontweight='bold')
ax_z.grid(True, ls='--', alpha=0.3)
ax_z.set_aspect('equal')
ax_z.legend(loc='upper left', fontsize=8)
ax_z.set_xlim(zx0, zx1)
F.save(fig3, 'q3_trajectory.png')

# result1.xlsx
out_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'output')
tab_dir = os.path.join(out_dir, 'tables')
res = pd.DataFrame(rows, columns=['无人机运动方向', '无人机运动速度 (m/s)', '烟幕干扰弹编号',
                                  '烟幕干扰弹投放点的x坐标 (m)', '烟幕干扰弹投放点的y坐标 (m)',
                                  '烟幕干扰弹投放点的z坐标 (m)', '烟幕干扰弹起爆点的x坐标 (m)',
                                  '烟幕干扰弹起爆点的y坐标 (m)', '烟幕干扰弹起爆点的z坐标 (m)',
                                  '有效干扰时长 (s)'])
res.to_excel(os.path.join(out_dir, 'result1.xlsx'), index=False)
print("  [表] result1.xlsx + q3_results.csv")

pd.DataFrame([
    ['航向角 theta (deg)', f'{np.degrees(theta_f)%360:.4f}'],
    ['速度 v (m/s)', f'{v_f:.4f}'],
    ['弹1 (t_d, tau)', f'({params_f[0][0]:.4f}, {params_f[0][1]:.4f})'],
    ['弹2 (t_d, tau)', f'({params_f[1][0]:.4f}, {params_f[1][1]:.4f})'],
    ['弹3 (t_d, tau)', f'({params_f[2][0]:.4f}, {params_f[2][1]:.4f})'],
    ['并集遮蔽时长 (s)', f'{dur_final:.4f}'],
    ['贪心基线时长 (s)', f'{d_greedy:.4f}'],
    ['G2网格互证 (s)', f'{dur_grid_check:.4f}'],
], columns=['量', '值']).to_csv(os.path.join(tab_dir, 'q3_results.csv'), index=False,
                               encoding='utf-8-sig')
print(f"\n总运行时间: {time.time()-t_start_all:.1f} s")

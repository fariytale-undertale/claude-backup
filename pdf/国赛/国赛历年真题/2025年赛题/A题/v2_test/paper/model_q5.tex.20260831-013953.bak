\begin{equation}
  \boxed{\Delta T_{\text{tot}}^* = 21.6465\ \mathrm{s}}
  \quad
  \begin{cases}
    M_1:\ 8.1481\ \mathrm{s}\ (\text{FY1+FY2}) \\
    M_2:\ 7.0686\ \mathrm{s}\ (\text{FY2+FY4}) \\

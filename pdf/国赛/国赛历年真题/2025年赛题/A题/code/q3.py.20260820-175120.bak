# -*- coding: utf-8 -*-
"""
问题三：利用无人机 FY1 投放 3 枚烟幕干扰弹实施对 M1 的干扰。

继承问题二模型，核心差异在于同机多弹共享航向速度约束：
- 3 枚弹的球心水平位置都落在同一条无人机路径线上（θ、v_u 唯一）。
- 目标：3 弹遮蔽时间并集最大化。
- 硬约束：同机两次投放间隔 ≥ 1 s。

构造方案：路径线-视线轴交点。对每个候选遮蔽窗口中心 t_c，求无人机路径线
（水平直线）与导弹在该时刻视线轴（三维直线 M(t_c)-T）的水平投影交点，
球心置于该点并以起爆后下沉量修正，反解投放时刻 t_d 与引信延迟 Δtb。
"""
import time
import numpy as np
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm
for fp in fm.findSystemFonts():
    if any(n in fp for n in ['SimHei', 'simhei', 'msyh', 'YaHei', 'SimSun', 'simsun']):
        try:
            fm.fontManager.addfont(fp)
        except Exception:
            pass
plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

from core import (G, VM, R_CLOUD, MISSILES, UAVS, missile_pos, missile_hit_time,
                  release_point, burst_point, shield_vec_plan, shield_vec,
                  VU_MIN, VU_MAX, TARGET_AXIS)

t0all = time.time()
U0 = UAVS['FY1']
M0 = MISSILES['M1']
THIT = missile_hit_time(M0)
REF = np.array([0.0, TARGET_AXIS[1], 5.0])
print(f"M1 飞行至假目标时间 ≈ {THIT:.2f} s")


def pathline_los_intersect(theta_deg, vu, U0, M0, REF, tc):
    """
    给定航向、速度、遮蔽窗口中心时刻 tc，求无人机路径线与视线轴水平投影交点，
    反解投放时刻与引信延迟。
    返回 (td, dttb, C) 或 None。
    """
    th = np.radians(theta_deg)
    dir_xy = np.array([np.cos(th), np.sin(th)])
    M = missile_pos(M0, tc)
    los = REF - M
    los_xy = los[:2]
    n_los = np.linalg.norm(los_xy)
    if n_los < 1e-6:
        return None
    los_xy = los_xy / n_los
    # 路径线: U0_xy + s*dir_xy (s = 沿路径距离), 视线轴水平: M_xy + lam*los_xy
    A = np.column_stack([dir_xy, -los_xy])
    b = M[:2] - U0[:2]
    if abs(np.linalg.det(A)) < 1e-9:
        return None
    sol = np.linalg.solve(A, b)
    s, lam = sol
    if s < 0 or lam < 0:
        return None
    C_xy = U0[:2] + s * dir_xy
    # 球心在三维视线轴上（用同一 lam 参数）
    L3 = los / np.linalg.norm(los)
    C_z = M[2] + lam * L3[2]
    C = np.array([C_xy[0], C_xy[1], C_z])
    # 反解：tau = td + dttb = s/vu
    tau = s / vu
    # 高度：C_z = U0_z - 0.5*g*dttb^2 - 3*(tc - tau)
    rhs = U0[2] - C_z - 3.0 * (tc - tau)
    if rhs < 0:
        return None
    dttb = np.sqrt(2.0 * rhs / G)
    td = tau - dttb
    if td < 0 or dttb < 0 or dttb > 19.0:
        return None
    Pb = burst_point(release_point(U0, theta_deg, vu, td), theta_deg, vu, dttb)
    if Pb[2] < 0:
        return None
    return (td, dttb, C)


def build_plan_table(theta_deg, vu, M0, U0, REF, tc_grid=np.arange(0.5, 62, 0.5)):
    """构建该航向速度下的单弹候选表（按窗口中心 tc 组织）。"""
    plans = []
    for tc in tc_grid:
        r = pathline_los_intersect(theta_deg, vu, U0, M0, REF, tc)
        if r is None:
            continue
        td, dttb, C = r
        # 评估该单弹遮蔽区间
        T, iv = shield_vec(theta_deg, vu, td, dttb, U0, M0, dt=0.02, n_phi=16, n_z=2)
        if T > 0:
            plans.append({'theta_deg': theta_deg, 'vu': vu, 'td': td, 'dttb': dttb,
                          'tc': tc, 'T': T, 'iv': iv})
    return plans


# =====================================================================
# STEP1：对每个航向速度组合构建弹表，枚举三弹组合
# =====================================================================
print("[STEP1] 构建弹表 + 枚举三弹组合（并集最大）...")
# 形态诊断：目标函数稀疏针尖形，采用结构驱动（路径线-视线轴交点构造）
best = None
best_T = 0.0
t_c1 = time.time()

# 航向扫描（迎向构型附近优先 + 全航向覆盖）
thetas = list(range(0, 360, 5))
# 先快速评估各航向的单弹潜力，选 top 航向精搜
per_theta = {}
for th in thetas:
    vu_cands = [80, 100, 120, 140]
    th_best = 0.0
    for vu in vu_cands:
        plans = build_plan_table(th, vu, M0, U0, REF, tc_grid=np.arange(0.5, 62, 1.0))
        if plans:
            T_single = max(p['T'] for p in plans)
            th_best = max(th_best, T_single)
    per_theta[th] = th_best
top_thetas = sorted(per_theta, key=lambda k: -per_theta[k])[:12]
print(f"  top 航向（单弹潜力）: {[(th, round(per_theta[th],2)) for th in top_thetas[:6]]}")

# 对 top 航向，细扫速度并枚举三弹组合
for th in top_thetas:
    for vu in [80, 90, 100, 110, 120, 140]:
        plans = build_plan_table(th, vu, M0, U0, REF, tc_grid=np.arange(0.5, 62, 0.5))
        if len(plans) < 3:
            continue
        # 枚举三弹组合（投放间隔 ≥ 1s）
        n = len(plans)
        for i in range(n):
            for j in range(i + 1, n):
                # 投放时刻排序，检查与第3弹组合
                td1, td2 = plans[i]['td'], plans[j]['td']
                if abs(td1 - td2) < 1.0:
                    continue
                for k in range(j + 1, n):
                    td3 = plans[k]['td']
                    tds = sorted([td1, td2, td3])
                    if min(tds[1]-tds[0], tds[2]-tds[1]) < 1.0:
                        continue
                    # 评估三弹并集
                    T, iv = shield_vec_plan([plans[i], plans[j], plans[k]], M0,
                                            dt=0.02, n_phi=16, n_z=2)
                    if T > best_T:
                        best_T = T
                        best = (th, vu, plans[i], plans[j], plans[k], iv)

print(f"  三弹组合枚举完成，用时 {time.time()-t_c1:.1f} s，最优并集 T={best_T:.3f}")

# =====================================================================
# STEP2：对最优解组合确认步长精算
# =====================================================================
th, vu, p1, p2, p3, iv0 = best
print("\n[STEP2] 确认步长 0.005 s 精算...")
plans_final = [p1, p2, p3]
T_final, iv_final = shield_vec_plan(plans_final, M0, dt=0.005, n_phi=48, n_z=4)
print(f"  遮蔽区间: {[tuple(round(x,3) for x in iv) for iv in iv_final]}")
print(f"  并集有效遮蔽时长 T = {T_final:.4f} s")
for idx, p in enumerate(plans_final, 1):
    print(f"  弹{idx}: td={p['td']:.3f} dttb={p['dttb']:.3f} 单弹区间={[tuple(round(x,3) for x in iv) for iv in p['iv']]}")

# =====================================================================
# G2/G3：最优性验证——对 top 航向做局部组合加密 + 全航向粗探
# =====================================================================
print("\n[G3 全域粗探] 对 top 航向邻域加密三弹组合...")
t_g = time.time()
T_enc = best_T
enc_best = best
for dth in [-2, -1, 0, 1, 2]:
    th2 = th + dth
    if th2 < 0:
        th2 += 360
    for dvu in [-10, 0, 10]:
        vu2 = vu + dvu
        if vu2 < VU_MIN or vu2 > VU_MAX:
            continue
        plans = build_plan_table(th2, vu2, M0, U0, REF, tc_grid=np.arange(0.5, 62, 0.5))
        if len(plans) < 3:
            continue
        n = len(plans)
        for i in range(n):
            for j in range(i+1, n):
                if abs(plans[i]['td'] - plans[j]['td']) < 1.0:
                    continue
                for k in range(j+1, n):
                    tds = sorted([plans[i]['td'], plans[j]['td'], plans[k]['td']])
                    if min(tds[1]-tds[0], tds[2]-tds[1]) < 1.0:
                        continue
                    T, iv = shield_vec_plan([plans[i], plans[j], plans[k]], M0,
                                            dt=0.03, n_phi=16, n_z=2)
                    if T > T_enc:
                        T_enc = T
                        enc_best = (th2, vu2, plans[i], plans[j], plans[k], iv)
print(f"  加密最优 T={T_enc:.3f}（原 {best_T:.3f}），用时 {time.time()-t_g:.1f} s")
if T_enc > best_T + 1e-6:
    print("  !! 加密发现更优，更新最优解")
    th, vu, p1, p2, p3, iv0 = enc_best
    plans_final = [p1, p2, p3]
    T_final, iv_final = shield_vec_plan(plans_final, M0, dt=0.005, n_phi=48, n_z=4)
    print(f"  更新后 T = {T_final:.4f} s")

# =====================================================================
# 约束复核
# =====================================================================
print("\n[约束复核]")
tds = sorted([p['td'] for p in plans_final])
print(f"  投放时刻: {[round(t,3) for t in tds]}")
print(f"  最小投放间隔: {min(tds[1]-tds[0], tds[2]-tds[1]):.3f} s ≥ 1 s ✓")
print(f"  航向 θ={th}° 唯一；速度 v_u={vu} m/s 唯一 ✓")
for p in plans_final:
    Pb = burst_point(release_point(U0, th, vu, p['td']), th, vu, p['dttb'])
    print(f"  弹 投放点({np.round(release_point(U0,th,vu,p['td']),1)}) 起爆点({np.round(Pb,1)}) 高度{Pb[2]:.1f}≥0")

# =====================================================================
# 图 + 结果
# =====================================================================
fig, ax = plt.subplots(figsize=(9, 3.5))
colors = ['#e74c3c', '#e67e22', '#3498db']
for idx, p in enumerate(plans_final):
    for iv in p['iv']:
        ax.barh(idx + 0.5, iv[1]-iv[0], left=iv[0], height=0.4, color=colors[idx], alpha=0.7, label=f'弹{idx+1}' if iv is p['iv'][0] else None)
for iv in iv_final:
    ax.barh(0.0, iv[1]-iv[0], left=iv[0], height=0.12, color='black', alpha=0.5, label='并集')
ax.set_xlabel('t (s)'); ax.set_yticks([])
ax.set_title(f'问题三：FY1 三弹遮蔽区间（并集 T={T_final:.3f} s）')
ax.legend(fontsize=8)
plt.tight_layout()
os.makedirs('output/figures', exist_ok=True)
plt.savefig('output/figures/q3_intervals.png', dpi=300)
print("图已保存: output/figures/q3_intervals.png")

import json
res = {
    'theta': th, 'vu': vu,
    'plans': [{'td': round(p['td'],3), 'dttb': round(p['dttb'],3),
               '投放点': np.round(release_point(U0,th,vu,p['td']),3).tolist(),
               '起爆点': np.round(burst_point(release_point(U0,th,vu,p['td']),th,vu,p['dttb']),3).tolist(),
               '遮蔽区间': [tuple(round(x,3) for x in iv) for iv in p['iv']]} for p in plans_final],
    '并集遮蔽区间': [tuple(round(x,3) for x in iv) for iv in iv_final],
    'T': round(T_final, 4),
}
os.makedirs('output/tables', exist_ok=True)
with open('output/tables/q3_result.json','w',encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print("结果已保存: output/tables/q3_result.json")
print(f"\n总用时 {time.time()-t0all:.1f} s")

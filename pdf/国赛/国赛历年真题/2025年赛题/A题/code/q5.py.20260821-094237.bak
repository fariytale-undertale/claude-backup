# -*- coding: utf-8 -*-
"""
问题五：利用 5 架无人机（FY1–FY5），每架至多投放 3 枚烟幕干扰弹，对 M1、M2、M3
三枚来袭导弹实施干扰，目标为三导弹遮蔽时长之和最大。

继承问题三（单机多弹共享航向速度）+ 问题四（多机协同）模型。
核心差异：多机多弹多目标，规模大。

求解框架：方案化贪心 + 局部换方案迭代改进。
- 每机每个 (θ,v_u) 方案构建「弹表」：对每枚导弹、每个遮蔽窗口中心，用路径线-视线轴
  交点反解投放参数，得一条候选弹记录（含投放时刻、遮蔽区间）。
- 贪心分配：每轮选取当前增量最大的弹（跨机、跨导弹），并检查该机该方案的投放间隔约束。
- 局部改进：每机尝试替换为其他 (θ,v_u) 方案并重新填弹，总遮蔽提高则接受。
"""
import time
import numpy as np
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm
for fp in fm.findSystemFonts():
    if any(n in fp for n in ['SimHei', 'simhei', 'msyh', 'YaHei', 'SimSun', 'simsun']):
        try:
            fm.fontManager.addfont(fp)
        except Exception:
            pass
plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

from core import (G, VM, R_CLOUD, MISSILES, UAVS, missile_pos, missile_hit_time,
                  release_point, burst_point, shield_vec, shield_vec_plan,
                  VU_MIN, VU_MAX, TARGET_AXIS)

t0all = time.time()
REF = np.array([0.0, TARGET_AXIS[1], 5.0])
MS = ['M1', 'M2', 'M3']
US = ['FY1', 'FY2', 'FY3', 'FY4', 'FY5']
MAX_PER_UAV = 3
DROP_GAP = 1.0


def pathline_los_intersect(theta_deg, vu, U0, M0, tc):
    """路径线-视线轴交点，反解 (td, dttb, C)。同问题三。"""
    th = np.radians(theta_deg)
    dir_xy = np.array([np.cos(th), np.sin(th)])
    M = missile_pos(M0, tc)
    los = REF - M
    los_xy = los[:2]
    nl = np.linalg.norm(los_xy)
    if nl < 1e-6:
        return None
    los_xy = los_xy / nl
    A = np.column_stack([dir_xy, -los_xy])
    b = M[:2] - U0[:2]
    if abs(np.linalg.det(A)) < 1e-9:
        return None
    sol = np.linalg.solve(A, b)
    s, lam = sol
    if s < 0 or lam < 0:
        return None
    C_xy = U0[:2] + s * dir_xy
    L3 = los / np.linalg.norm(los)
    C_z = M[2] + lam * L3[2]
    C = np.array([C_xy[0], C_xy[1], C_z])
    tau = s / vu
    rhs = U0[2] - C_z - 3.0 * (tc - tau)
    if rhs < 0:
        return None
    dttb = np.sqrt(2.0 * rhs / G)
    td = tau - dttb
    if td < 0 or dttb < 0 or dttb > 19.0:
        return None
    Pb = burst_point(release_point(U0, theta_deg, vu, td), theta_deg, vu, dttb)
    if Pb[2] < 0:
        return None
    return (td, dttb, C)


def build_scheme_table(theta_deg, vu, U0, M0, tc_grid=np.arange(0.5, 60, 1.0)):
    """
    构建单机单导弹弹表：每条 = 一个候选弹（球心对准该导弹视线轴）。
    返回 list of dict(td, dttb, T, iv)。
    """
    plans = []
    for tc in tc_grid:
        r = pathline_los_intersect(theta_deg, vu, U0, M0, tc)
        if r is None:
            continue
        td, dttb, C = r
        T, iv = shield_vec(theta_deg, vu, td, dttb, U0, M0, dt=0.05, n_phi=12, n_z=2)
        if T > 0.05:
            plans.append({'td': td, 'dttb': dttb, 'T': T, 'iv': iv, 'theta_deg': theta_deg,
                          'vu': vu, 'U0': U0})
    return plans


# =====================================================================
# STEP1：预构建每机每方案每导弹的弹表
# =====================================================================
print("[STEP1] 预构建方案弹表...")
# 方案池：航向 10° 步长 × 速度 [80, 100, 120, 140]
schemes = []
for th in range(0, 360, 10):
    for vu in [80.0, 100.0, 120.0, 140.0]:
        schemes.append((th, vu))
print(f"  方案池 {len(schemes)} 个航向速度组合")

# 每机：{导弹: [弹表]}，弹表按 T 降序
uav_scheme_tables = {}   # uav -> {missile: [plans]}
for u in US:
    uav_scheme_tables[u] = {}
    for m in MS:
        uav_scheme_tables[u][m] = []
    for th, vu in schemes:
        for m in MS:
            plans = build_scheme_table(th, vu, UAVS[u], MISSILES[m])
            for p in plans:
                p['missile'] = m
                p['uav'] = u
                p['th_scheme'] = (th, vu)
                uav_scheme_tables[u][m].append(p)
print(f"  弹表构建完成，用时 {time.time()-t0all:.1f} s")


# =====================================================================
# STEP2：贪心分配 + 局部改进
# =====================================================================
def eval_total(assignments):
    """评估总遮蔽时长。assignments: {uav: [(missile, plan), ...]}"""
    total = 0.0
    per_missile = {m: [] for m in MS}
    for u, lst in assignments.items():
        for m, p in lst:
            per_missile[m].append(p)
    for m in MS:
        if per_missile[m]:
            T, _ = shield_vec_plan(per_missile[m], MISSILES[m], dt=0.05, n_phi=12, n_z=2)
            total += T
    return total


def check_constraints(uav, lst):
    """检查该机投放间隔约束：投放时刻排序后相邻间隔 >= 1s。"""
    tds = sorted(p['td'] for _, p in lst)
    for i in range(1, len(tds)):
        if tds[i] - tds[i-1] < DROP_GAP:
            return False
    return True


print("\n[STEP2] 方案化贪心分配...")
# 贪心：每轮选增量最大的候选弹
assignments = {u: [] for u in US}   # {uav: [(missile, plan)]}
t_g = time.time()
while True:
    best_gain = 0.0
    best_move = None
    for u in US:
        cur = assignments[u]
        if len(cur) >= MAX_PER_UAV:
            continue
        # 该机当前方案（若有）
        cur_scheme = None
        if cur:
            cur_scheme = cur[0][1]['th_scheme']
        for m in MS:
            # 该机该导弹的候选弹（需匹配该机当前方案，若无方案则任意）
            cands = uav_scheme_tables[u][m]
            if cur_scheme is not None:
                cands = [p for p in cands if p['th_scheme'] == cur_scheme]
            if not cands:
                continue
            for p in cands:
                # 候选是否已在分配中
                if any(p is q for _, q in cur):
                    continue
                # 模拟加入
                trial = cur + [(m, p)]
                if not check_constraints(u, trial):
                    continue
                # 计算加入该弹后该导弹遮蔽增量
                miss_lst = [q for mm, q in assignments[u] if mm == m] + [p]
                T_before = shield_vec_plan(miss_lst[:-1], MISSILES[m], dt=0.05, n_phi=12, n_z=2)[0] if len(miss_lst) > 1 else 0.0
                T_after = shield_vec_plan(miss_lst, MISSILES[m], dt=0.05, n_phi=12, n_z=2)[0]
                gain = T_after - T_before
                if gain > best_gain:
                    best_gain = gain
                    best_move = (u, m, p)
    if best_move is None or best_gain <= 0.01:
        break
    u, m, p = best_move
    # 若该机已有不同方案的弹，则需统一方案
    cur = assignments[u]
    if cur and cur[0][1]['th_scheme'] != p['th_scheme']:
        # 丢弃旧弹，改用新方案
        assignments[u] = [(m, p)]
    else:
        assignments[u].append((m, p))
    # 贪心循环继续

print(f"  贪心分配完成，用时 {time.time()-t_g:.1f} s")
T_total = eval_total(assignments)
print(f"  贪心总遮蔽 T = {T_total:.3f} s")
for u in US:
    lst = assignments[u]
    if lst:
        print(f"  {u}: {len(lst)}弹 方案θ={lst[0][1]['th_scheme'][0]}° v={lst[0][1]['th_scheme'][1]} " +
              f"导弹分布={[m for m,_ in lst]}")

# 局部改进：每机换方案
print("\n[STEP3] 局部换方案改进...")
t_imp = time.time()
improved = True
n_iter = 0
while improved and n_iter < 10:
    improved = False
    n_iter += 1
    for u in US:
        cur = assignments[u]
        best_T_u = eval_total(assignments)
        best_repl = None
        # 尝试该机所有方案
        for th, vu in schemes:
            # 用该方案重新为每导弹选最优弹
            new_lst = []
            for m in MS:
                cands = [p for p in uav_scheme_tables[u][m] if p['th_scheme'] == (th, vu)]
                cands.sort(key=lambda p: -p['T'])
                if cands:
                    new_lst.append((m, cands[0]))
            # 检查投放间隔
            if not check_constraints(u, new_lst):
                continue
            new_lst = new_lst[:MAX_PER_UAV]
            trial = dict(assignments)
            trial[u] = new_lst
            T_trial = eval_total(trial)
            if T_trial > best_T_u + 0.01:
                best_T_u = T_trial
                best_repl = new_lst
        if best_repl is not None:
            assignments[u] = best_repl
            improved = True
print(f"  局部改进 {n_iter} 轮，用时 {time.time()-t_imp:.1f} s")
T_total = eval_total(assignments)
print(f"  改进后总遮蔽 T = {T_total:.3f} s")
for u in US:
    lst = assignments[u]
    if lst:
        print(f"  {u}: {len(lst)}弹 方案θ={lst[0][1]['th_scheme'][0]}° v={lst[0][1]['th_scheme'][1]} " +
              f"导弹分布={[m for m,_ in lst]}")

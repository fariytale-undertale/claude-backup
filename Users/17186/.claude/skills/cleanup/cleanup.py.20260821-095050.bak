#!/usr/bin/env python3
"""cleanup: 先传后删的清理工具。

把项目里的非必要文件（缓存 / 备份 / 中间版本）归档到本地备份仓库
D:/code-backup/cleanup/<date>/<project>/ 并 push 到 GitHub
(git@github.com:fariytale-undertale/claude-backup.git)，push 成功后删除本地原文件。

用法:
  cleanup.py scan [--dir TARGET]                只扫描，打印两档清单，不做任何修改
  cleanup.py run  [--dir TARGET] [--yes-backup] 完整流程；备份类文件需 --yes-backup

安全契约: 只有 git push 成功才删除本地文件（先传后删），备份类文件必须经用户确认。
"""
import argparse
import fnmatch
import os
import re
import shutil
import subprocess
import sys
import time

BACKUP_ROOT = r"D:/code-backup"
REMOTE = "origin"
REMOTE_URL = "git@github.com:fariytale-undertale/claude-backup.git"
BRANCH = "main"

# 永不扫描的目录（依赖/仓库/备份库自身）
SKIP_DIRS = {".git", "node_modules", "venv", ".venv", "env", "site-packages",
             ".claude", "__pycache__", ".pytest_cache", ".mypy_cache",
             ".ruff_cache", ".hypothesis"}
# 缓存类目录（可自动删）：与 SKIP_DIRS 中的缓存目录重合，单独列出以作删除目标
CACHE_DIRS = {"__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".hypothesis"}

# 缓存类扩展名（自动删，无保留价值）
CACHE_EXTS = {".pyc", ".pyo", ".aux", ".toc", ".out", ".bbl", ".blg",
              ".synctex.gz", ".fdb_latexmk", ".fls", ".tmp"}
CACHE_FILES = {".coverage", "Thumbs.db", ".DS_Store"}

# 备份类扩展名（需确认）
BACKUP_EXTS = {".bak", ".orig", ".rej", ".swp", ".sav", ".save", ".old", ".log"}
# 备份类文件名模式（需确认）
BACKUP_PATTERNS = [
    re.compile(r"~\$.*"),            # Office 临时锁文件
    re.compile(r".*~$"),             # vim 备份 file~
    re.compile(r".*_backup.*", re.I),
    re.compile(r".*_copy.*", re.I),
    re.compile(r".*_old($|\..*)", re.I),
    re.compile(r".*_draft.*", re.I),
    re.compile(r".*_v\d+.*", re.I),  # *_v2, *_v3 等版本
    re.compile(r".*_final_old.*", re.I),
    re.compile(r"^tmp_.*", re.I),
    re.compile(r"^scratch.*", re.I),
    re.compile(r"^test_scratch.*", re.I),
]
# 备份类目录名模式
BACKUP_DIR_PATTERNS = [
    re.compile(r".*_backup.*", re.I),
    re.compile(r".*_old.*", re.I),
    re.compile(r"^tmp_.*", re.I),
    re.compile(r"^scratch.*", re.I),
]


class FileCat:
    """一个待清理文件项。"""

    def __init__(self, path, cat):
        self.path = path
        self.cat = cat          # "cache" 或 "backup"
        self.is_dir = os.path.isdir(path)

    @property
    def size(self):
        try:
            if self.is_dir:
                total = 0
                for dp, _, fs in os.walk(self.path):
                    for f in fs:
                        try:
                            total += os.path.getsize(os.path.join(dp, f))
                        except OSError:
                            pass
                return total
            return os.path.getsize(self.path)
        except OSError:
            return 0


def classify(path):
    """返回 'cache' / 'backup' / None。"""
    base = os.path.basename(path.rstrip("/\\"))
    if os.path.isdir(path):
        if base in CACHE_DIRS:
            return "cache"
        if any(p.match(base) for p in BACKUP_DIR_PATTERNS):
            return "backup"
        return None
    ext = os.path.splitext(base)[1].lower()
    if base in CACHE_FILES:
        return "cache"
    if ext in CACHE_EXTS:
        return "cache"
    if ext in BACKUP_EXTS:
        return "backup"
    if any(p.match(base) for p in BACKUP_PATTERNS):
        return "backup"
    return None


def scan(target):
    """扫描 target，返回 cache 项列表和 backup 项列表（已排序）。"""
    cache, backup = [], []
    for root, dirs, files in os.walk(target):
        # 剪枝：不进 node_modules 等，但缓存目录本身保留为删除目标
        dirs[:] = [d for d in dirs
                   if d not in SKIP_DIRS or d in CACHE_DIRS]
        for d in dirs:
            full = os.path.join(root, d)
            cat = classify(full)
            if cat == "cache":
                cache.append(FileCat(full, "cache"))
            elif cat == "backup":
                backup.append(FileCat(full, "backup"))
        for f in files:
            full = os.path.join(root, f)
            cat = classify(full)
            if cat:
                (cache if cat == "cache" else backup).append(FileCat(full, cat))
    cache.sort(key=lambda x: x.path)
    backup.sort(key=lambda x: x.path)
    return cache, backup


def fmt_size(n):
    for unit in ["B", "KB", "MB", "GB"]:
        if n < 1024 or unit == "GB":
            return f"{n:.1f}{unit}" if unit != "B" else f"{n}B"
        n /= 1024
    return f"{n:.1f}GB"


def print_list(items, title):
    print(f"\n== {title} ({len(items)} 项) ==")
    for it in items:
        mark = "[D]" if it.is_dir else "[F]"
        print(f"  {mark} {it.path}  ({fmt_size(it.size)})")


def git(cwd, *args):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True,
                       text=True, encoding="utf-8", errors="replace")
    return r


def archive_and_push(target, items):
    """把 items 复制进备份仓库并 commit + push。返回 (成功, 归档列表)。"""
    stamp = time.strftime("%Y%m%d")
    proj = os.path.basename(os.path.normpath(target)) or "root"
    base = os.path.join(BACKUP_ROOT, "cleanup", stamp, proj)
    archived = []
    for it in items:
        rel = os.path.relpath(it.path, target)
        dest = os.path.join(base, rel)
        try:
            if it.is_dir:
                shutil.copytree(it.path, dest, dirs_exist_ok=True)
            else:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                shutil.copy2(it.path, dest)
            archived.append((it, dest))
        except Exception as e:
            print(f"[cleanup] 归档失败 {it.path}: {e}", file=sys.stderr)

    if not archived:
        print("[cleanup] 没有文件归档成功，跳过 git。", file=sys.stderr)
        return False, []

    if not os.path.isdir(os.path.join(BACKUP_ROOT, ".git")):
        print(f"[cleanup] 备份仓库未初始化: {BACKUP_ROOT} 不是 git 仓库，先运行初始化。",
              file=sys.stderr)
        return False, []

    r = git(BACKUP_ROOT, "add", "-A")
    if r.returncode != 0:
        print(f"[cleanup] git add 失败: {r.stderr}", file=sys.stderr)
        return False, []

    msg = f"cleanup: {proj} {stamp} ({len(archived)} files)"
    r = git(BACKUP_ROOT, "commit", "-m", msg)
    if r.returncode != 0 and "nothing to commit" not in r.stdout:
        print(f"[cleanup] git commit 失败: {r.stderr}", file=sys.stderr)
        return False, []

    r = git(BACKUP_ROOT, "push", REMOTE, BRANCH)
    if r.returncode != 0:
        print(f"[cleanup] git push 失败，本地未删除任何文件。stderr:\n{r.stderr}",
              file=sys.stderr)
        return False, []
    print(f"[cleanup] push 成功: {REMOTE_URL}")
    return True, archived


def delete_local(archived):
    for it, _dest in archived:
        try:
            if it.is_dir:
                shutil.rmtree(it.path)
            else:
                os.remove(it.path)
            print(f"[cleanup] 已删除 {it.path}")
        except Exception as e:
            print(f"[cleanup] 删除失败 {it.path}: {e}", file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(description="cleanup: 先传后删的清理工具")
    ap.add_argument("cmd", choices=["scan", "run"])
    ap.add_argument("--dir", default=os.getcwd(), help="要清理的目标目录（默认当前目录）")
    ap.add_argument("--yes-backup", action="store_true",
                    help="确认删除备份/中间版本类文件（必须先人工过清单）")
    args = ap.parse_args()

    target = os.path.abspath(args.dir)
    norm_target = os.path.normpath(target)
    norm_backup = os.path.normpath(BACKUP_ROOT)
    if norm_target == norm_backup or norm_target.startswith(norm_backup + os.sep):
        print(f"[cleanup] 拒绝清理备份仓库自身: {BACKUP_ROOT}", file=sys.stderr)
        return 2
    if not os.path.isdir(target):
        print(f"[cleanup] 目标目录不存在: {target}", file=sys.stderr)
        return 2

    cache, backup = scan(target)
    print(f"[cleanup] 目标: {target}")
    print_list(cache, "缓存类（可安全删除）")
    print_list(backup, "备份/中间版类（需确认）")
    total = fmt_size(sum(x.size for x in cache + backup))
    print(f"\n合计: {len(cache) + len(backup)} 项 / {total}")

    if args.cmd == "scan":
        print("\n[cleanup] scan 模式，未做任何修改。")
        return 0

    # run 模式
    if not cache and not backup:
        print("[cleanup] 无可清理项，结束。")
        return 0
    if backup and not args.yes_backup:
        print("\n[cleanup] 存在备份/中间版类文件，需人工确认后加 --yes-backup 再执行。",
              file=sys.stderr)
        return 1

    ok, archived = archive_and_push(target, cache + backup)
    if not ok:
        return 1
    delete_local(archived)
    print(f"\n[cleanup] 完成: 归档 {len(archived)} 项到备份仓库，本地已清理。")
    return 0


if __name__ == "__main__":
    sys.exit(main())

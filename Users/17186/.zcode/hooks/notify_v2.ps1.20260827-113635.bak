# notify_v2.ps1 — ZCode 自定义 WPF 弹窗（400x200，信息充实版）
# 用法: notify_v2.ps1 -Title "..." -Text "..." -Priority question|permission|done|idle
param(
    [string]$Title = "ZCode",
    [string]$Text  = "",
    [string]$Priority = "question"
)
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName PresentationCore
Add-Type -AssemblyName WindowsBase

# 优先级 -> 配色 + 标签（信息编码：颜色与标签随事件类型变化）
# 配色采用 ZCode 蓝色系，与 Claude 通知的橙色品牌色区分
$palette = @{
    question   = @{ bar = "#4C8DF6"; dot = "#4C8DF6"; tag = "需要你" }
    permission = @{ bar = "#4C8DF6"; dot = "#4C8DF6"; tag = "需批准" }
    done       = @{ bar = "#79A38B"; dot = "#79A38B"; tag = "已完成" }
    idle       = @{ bar = "#6E6B76"; dot = "#6E6B76"; tag = "空闲" }
}
$c = $palette[$Priority]
if (-not $c) { $c = $palette['question'] }
if (-not $Text) { $Text = "后台 agent 需要你的注意，请返回 ZCode 终端查看。" }

$xaml = @'
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZCode" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Width="400" Height="200" ResizeMode="NoResize" WindowStartupLocation="Manual">
  <Border CornerRadius="14" Background="#1E1D24" BorderBrush="#3A3842"
          BorderThickness="1" Margin="2">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="38"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="Bar" Grid.Column="0" Background="__BAR__"/>

      <!-- 内容区 -->
      <Grid Grid.Column="1" Margin="18,16,10,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 行0：标题 + 类型标签 -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12" Fill="__DOT__"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="TitleText" Grid.Column="1" Text="__TITLE__"
                     FontFamily="Microsoft YaHei UI" FontWeight="Bold" FontSize="16"
                     Foreground="#F2EFE9" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" MaxWidth="250"/>
          <Border Grid.Column="2" CornerRadius="10" Background="#2A2830"
                  Padding="10,3" VerticalAlignment="Center">
            <TextBlock Text="__TAG__" FontFamily="Microsoft YaHei UI" FontSize="11"
                       FontWeight="SemiBold" Foreground="__DOT__"/>
          </Border>
        </Grid>

        <!-- 行1：分隔线 -->
        <Border Grid.Row="1" Height="1" Background="#2E2D35" Margin="0,12,0,12"/>

        <!-- 行2：正文（弹性区） -->
        <TextBlock x:Name="BodyText" Grid.Row="2" Text="__TEXT__"
                   FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#B0ADB8"
                   TextWrapping="Wrap" VerticalAlignment="Top" MaxHeight="92"/>

        <!-- 行3：底部双信息 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="点击查看 ZCode 终端"
                     FontFamily="Consolas" FontSize="10" Foreground="#5C5A64"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="点击任意位置关闭"
                     FontFamily="Consolas" FontSize="10" Foreground="#5C5A64"
                     VerticalAlignment="Center"/>
        </Grid>
      </Grid>

      <!-- 关闭按钮 -->
      <Button x:Name="CloseBtn" Grid.Column="2" Content="&#x2715;" Width="28" Height="28"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,10,0"
              FontFamily="Consolas" FontSize="14" Foreground="#8A8791"
              Background="Transparent" BorderThickness="0" Cursor="Hand">
        <Button.Style>
          <Style TargetType="Button">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#F2EFE9"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </Grid>
  </Border>
</Window>
'@

function Esc([string]$s) {
    return ($s -replace '&','&amp;' -replace '<','&lt;' -replace '>','&gt;' `
                  -replace '"','&quot;')
}
$xaml = $xaml.Replace('__BAR__', $c.bar)
$xaml = $xaml.Replace('__DOT__', $c.dot)
$xaml = $xaml.Replace('__TAG__', (Esc $c.tag))
$xaml = $xaml.Replace('__TITLE__', (Esc $Title))
$xaml = $xaml.Replace('__TEXT__', (Esc $Text))

$reader = [System.Xml.XmlReader]::Create([System.IO.StringReader]::new($xaml))
try { $window = [System.Windows.Markup.XamlReader]::Load($reader) }
catch { Write-Error "XAML加载失败: $($_.Exception.InnerException.Message)"; exit 1 }
if (-not $window) { Write-Error "窗口创建失败"; exit 1 }

$work = [System.Windows.SystemParameters]::WorkArea
$window.Left = $work.Right - $window.Width - 18
$window.Top  = $work.Bottom - $window.Height - 18

# ---------- 点击激活 ZCode 终端 ----------
# 说明：ZCode CLI 跑在 Windows Terminal（ConPTY）里，ConPTY 会把终端内进程的
# 父进程链重定向到 explorer，因此不能靠 ParentProcessId 回溯到终端窗口；
# 正确做法是枚举终端宿主窗口（WindowsTerminal 等），唯一者即命中。
$script:user32Loaded = $false

function Find-ZCodeTerminalWindow {
    # 有 UI 的现代终端宿主（ConPTY 场景，窗口就挂在它们名下）
    $modern = @('windowsterminal', 'wt', 'mintty', 'wezterm', 'alacritty', 'ghostty')
    # 当前所有带主窗口的进程（排除弹窗自身）
    $windows = @(Get-Process -ErrorAction SilentlyContinue |
        Where-Object { $_.MainWindowHandle -ne 0 -and $_.Id -ne $PID -and $_.MainWindowTitle })

    # 1) 现代终端：标题含 zcode 优先 → 唯一者 → 最新启动
    $hosts = @($windows | Where-Object { $modern -contains $_.ProcessName.ToLower() })
    if ($hosts.Count -gt 0) {
        $byTitle = $hosts | Where-Object { $_.MainWindowTitle -match 'zcode' } | Select-Object -First 1
        if ($byTitle) { return $byTitle }
        if ($hosts.Count -eq 1) { return $hosts[0] }
        return $hosts | Sort-Object StartTime -Descending | Select-Object -First 1
    }

    # 2) 传统终端兜底：从 zcode 进程向上回溯父链，找第一个带主窗口的终端宿主
    #    （mintty 独立窗口 / cmd 的 conhost 等；会回溯到 explorer 则因不在名单里而跳过）
    try {
        $seed = Get-CimInstance Win32_Process -Filter "Name='zcode.exe'" | Select-Object -First 1
        if (-not $seed) {
            $seed = Get-CimInstance Win32_Process -Filter "Name='node.exe'" |
                Where-Object { $_.CommandLine -match 'zcode' } | Select-Object -First 1
        }
        $cur = $seed
        $hostAll = $modern + @('conhost', 'openconsole', 'cmd', 'bash', 'powershell', 'pwsh')
        for ($i = 0; $i -lt 8 -and $cur; $i++) {
            $proc = Get-Process -Id $cur.ProcessId -ErrorAction SilentlyContinue
            if ($proc -and $proc.MainWindowHandle -ne 0 -and
                ($hostAll -contains $proc.ProcessName.ToLower())) {
                return $proc
            }
            $cur = Get-CimInstance Win32_Process -Filter "ProcessId=$($cur.ParentProcessId)" -ErrorAction SilentlyContinue
        }
    } catch {}

    return $null
}

function Show-ZCodeTerminal {
    # 惰性编译 user32 P/Invoke，避免拖慢弹窗出现；点击时只编译一次
    if (-not $script:user32Loaded) {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
namespace Native { public static class User32 {
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
} }
'@
        $script:user32Loaded = $true
    }
    $win = Find-ClaudeTerminalWindow
    if ($win -and $win.MainWindowHandle -ne 0) {
        [Native.User32]::ShowWindow($win.MainWindowHandle, 9)   # SW_RESTORE：最小化则恢复
        [Native.User32]::SetForegroundWindow($win.MainWindowHandle)
    }
}

$CloseBtn = $window.FindName('CloseBtn')
$CloseBtn.Add_Click({ try { Show-ClaudeTerminal } catch {}; $window.Close() })
$window.Add_MouseLeftButtonDown({ try { Show-ClaudeTerminal } catch {}; $window.Close() })
$window.Add_Closed({ [System.Windows.Threading.Dispatcher]::CurrentDispatcher.InvokeShutdown() })

$fadeIn = [System.Windows.Media.Animation.DoubleAnimation]::new(0.0, 1.0, [TimeSpan]::FromMilliseconds(280))
$window.BeginAnimation([System.Windows.Window]::OpacityProperty, $fadeIn)

$app = New-Object System.Windows.Application
$app.Run($window) | Out-Null
